include("${CMAKE_CURRENT_LIST_DIR}/../cmake/LegacyOptions.cmake")
if(CASE STREQUAL "legacy")
    if(NOT MIKUMIKUSTUDIO_PROFILE STREQUAL "mmd932" OR MIKUMIKUSTUDIO_ENABLE_DX12 OR NOT MIKUMIKUSTUDIO_WIN7_BASELINE)
        message(FATAL_ERROR "Legacy profile/DX12/Win7 cache was not preserved")
    endif()
elseif(CASE STREQUAL "override")
    if(NOT MIKUMIKUSTUDIO_PROFILE STREQUAL "full" OR NOT MIKUMIKUSTUDIO_ENABLE_DX12 OR MIKUMIKUSTUDIO_WIN7_BASELINE)
        message(FATAL_ERROR "Explicit new options did not take precedence")
    endif()
elseif(CASE STREQUAL "fresh")
    if(DEFINED MIKUMIKUSTUDIO_PROFILE OR DEFINED MIKUMIKUSTUDIO_ENABLE_DX12 OR DEFINED MIKUMIKUSTUDIO_WIN7_BASELINE)
        message(FATAL_ERROR "Fresh build defaults must remain untouched")
    endif()
else()
    message(FATAL_ERROR "Unknown case")
endif()
message(STATUS "Legacy build option test passed: ${CASE}")
