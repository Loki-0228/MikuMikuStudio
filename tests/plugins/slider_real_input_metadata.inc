#pragma once
// UI-thread observation only. Attach/Detach/Write and destruction belong to the
// window's UI thread, outside an active callback. Only the published atomics
// may be read from a capture thread. No input is generated by this observer.
#ifndef NOMINMAX
#define NOMINMAX
#endif
