namespace slider_real_input_metadata {
inline constexpr std::array<int,13> kIds={447,455,456,457,458,459,460,505,510,515,520,534,560};
class Trace {
    static constexpr std::size_t kCapacity=32768;
    struct Dc {
        std::uintptr_t value=0,window=0,bitmap=0;DWORD type=0;int mapMode=0,clipKind=ERROR,bitmapBytes=0,width=0,height=0;
        bool originOk=false,viewportOk=false,windowOriginOk=false,dib=false;
        POINT origin{},viewport{},windowOrigin{};RECT clip{};
    };
    struct Facts {
        LONGLONG qpc=0;DWORD thread=0,lastError=0;std::uintptr_t focus=0,capture=0,foreground=0;
        LRESULT ui=0;bool uiAvailable=false,alive=false;Dc dc{};
        bool sidebarDragging=false,bottomDragging=false,bottomRelayout=false,mainCapture=false,layoutDragging=false,mainClientKnown=false;
        int bottomIndex=-1,sidebarWidth=0;RECT mainClient{};
    };
    struct Event {
        std::uint64_t sequence=0,parent=0;unsigned depth=0,phase=0;std::uintptr_t window=0;
        int id=0;UINT message=0;WPARAM wp=0;LPARAM lp=0;LRESULT result=0;
        DWORD sendFlags=0,messageTime=0;LPARAM extraInfo=0;
        bool returned=false,notifyHeader=false,customDraw=false;std::uintptr_t source=0;UINT_PTR sourceId=0;
        UINT notifyCode=0,drawStage=0,itemState=0;DWORD_PTR item=0;RECT drawRect{};
        std::uintptr_t suppliedDc=0,returnedBrush=0;bool brushKnown=false;UINT brushStyle=0;COLORREF brushColor=0;
        Facts entry{},exit{};
    };
    struct Watch {HWND window=nullptr;int id=0;bool installed=false,unicodeBefore=false,unicodeAfter=false;};
    // These forwarding records outlive Trace. A later outer subclass must not
    // be overwritten on Detach, nor retain a pointer to a destroyed recorder.
    struct Route {HWND window=nullptr;WNDPROC original=nullptr;Trace* trace=nullptr;unsigned index=0;bool unicode=false;};
    static std::array<Route,14>& Routes()noexcept{static thread_local std::array<Route,14> routes{};return routes;}
    mikudancestudio::MMDApp& app_;
    const DWORD ownerThread_=GetCurrentThreadId();
    std::unique_ptr<Event[]> storage_=std::make_unique<Event[]>(kCapacity);
    std::array<Watch,14> watches_{};
    std::atomic<std::uint64_t> sequence_{0},inputCount_{0};
    std::atomic<bool> layoutDrag_{false};
    std::atomic<unsigned> phase_{0};
    std::uint64_t next_=0,active_=0,overwrittenReturns_=0;unsigned depth_=0,factsDepth_=0;
    bool attached_=false;DWORD attachError_=0,detachError_=0;unsigned detachConflicts_=0;

    static std::uintptr_t Bits(const void* value)noexcept{return reinterpret_cast<std::uintptr_t>(value);}
    static bool Readable(const void* pointer,std::size_t bytes)noexcept{
        auto address=Bits(pointer);if(!address||bytes>std::uintptr_t(-1)-address)return false;
        const auto end=address+bytes;
        for(unsigned regions=0;address<end&&regions<4;++regions){MEMORY_BASIC_INFORMATION memory{};
            if(VirtualQuery(reinterpret_cast<const void*>(address),&memory,sizeof(memory))!=sizeof(memory)||memory.State!=MEM_COMMIT||
                (memory.Protect&(PAGE_GUARD|PAGE_NOACCESS)))return false;
            const auto protection=memory.Protect&0xffu;
            if(protection!=PAGE_READONLY&&protection!=PAGE_READWRITE&&protection!=PAGE_WRITECOPY&&
                protection!=PAGE_EXECUTE_READ&&protection!=PAGE_EXECUTE_READWRITE&&protection!=PAGE_EXECUTE_WRITECOPY)return false;
            const auto begin=Bits(memory.BaseAddress);if(memory.RegionSize>std::uintptr_t(-1)-begin)return false;
            const auto next=begin+memory.RegionSize;if(next<=address)return false;address=next;
        }
        return address>=end;
    }
    template<class T> static bool Copy(const void* pointer,T& result)noexcept{
        if(!Readable(pointer,sizeof(T)))return false;
        // Do not touch NOACCESS/guard pages merely for diagnostic metadata.
        // The isolated POD copy also tolerates a page changing after the query.
        __try {std::memcpy(&result,pointer,sizeof(T));return true;}
        __except(EXCEPTION_EXECUTE_HANDLER){return false;}
    }
    static bool Mouse(UINT message)noexcept{return message>=0x200&&message<=0x20e;}
    static bool Input(UINT message)noexcept{
        return message==WM_MOUSEMOVE||message==WM_LBUTTONDOWN||message==WM_LBUTTONUP||message==WM_LBUTTONDBLCLK||
            message==WM_RBUTTONDOWN||message==WM_RBUTTONUP||message==WM_RBUTTONDBLCLK||
            message==WM_MBUTTONDOWN||message==WM_MBUTTONUP||message==WM_MBUTTONDBLCLK||
            message==WM_XBUTTONDOWN||message==WM_XBUTTONUP||message==WM_XBUTTONDBLCLK;
    }
    static bool Interesting(UINT message)noexcept{
        if(Mouse(message)||(message>=WM_KEYFIRST&&message<=WM_KEYLAST))return true;
        switch(message){
        case WM_TIMER:case 0x0118: // WM_SYSTIMER: observe only; never generate or consume it specially.
        case WM_MOUSEHOVER:case WM_MOUSELEAVE:case WM_NCMOUSEHOVER:case WM_NCMOUSELEAVE:
        case WM_SETFOCUS:case WM_KILLFOCUS:case WM_CAPTURECHANGED:case WM_CANCELMODE:
        case WM_CHANGEUISTATE:case WM_UPDATEUISTATE:case WM_QUERYUISTATE:
        case WM_PAINT:case WM_ERASEBKGND:case WM_PRINT:case WM_PRINTCLIENT:case WM_NOTIFY:case WM_CTLCOLORSTATIC:
        case WM_HSCROLL:case WM_VSCROLL:case WM_COMMAND:
        case WM_ENABLE:case WM_SHOWWINDOW:case WM_SIZE:case WM_MOVE:case WM_SIZING:case WM_MOVING:
        case WM_ENTERSIZEMOVE:case WM_EXITSIZEMOVE:case WM_SETCURSOR:case WM_WINDOWPOSCHANGING:case WM_WINDOWPOSCHANGED:
        case WM_THEMECHANGED:case WM_SYSCOLORCHANGE:case WM_SETTINGCHANGE:case WM_STYLECHANGING:case WM_STYLECHANGED:
        case WM_SETREDRAW:case WM_NCDESTROY:case 0x02e0: // WM_DPICHANGED, observation only on newer systems.
        case TBM_SETPOS:case TBM_SETRANGE:case TBM_SETRANGEMIN:case TBM_SETRANGEMAX:
        case TBM_SETTICFREQ:case TBM_SETTHUMBLENGTH:case TBM_SETSEL:case TBM_SETSELSTART:case TBM_SETSELEND:
        case TBM_CLEARTICS:case TBM_CLEARSEL:case TBM_SETLINESIZE:case TBM_SETPAGESIZE:return true;
        default:return false;
        }
    }
    static Dc DcFacts(HDC dc)noexcept{
        Dc result;result.value=Bits(dc);if(!dc)return result;
        result.type=GetObjectType(dc);if(result.type!=OBJ_DC&&result.type!=OBJ_MEMDC&&result.type!=OBJ_METADC&&result.type!=OBJ_ENHMETADC)return result;
        result.window=Bits(WindowFromDC(dc));result.mapMode=GetMapMode(dc);result.clipKind=GetClipBox(dc,&result.clip);
        result.originOk=GetDCOrgEx(dc,&result.origin)!=FALSE;result.viewportOk=GetViewportOrgEx(dc,&result.viewport)!=FALSE;
        result.windowOriginOk=GetWindowOrgEx(dc,&result.windowOrigin)!=FALSE;
        if(result.type==OBJ_MEMDC){const auto bitmap=GetCurrentObject(dc,OBJ_BITMAP);result.bitmap=Bits(bitmap);DIBSECTION info{};
            result.bitmapBytes=bitmap?GetObjectW(bitmap,sizeof(info),&info):0;
            if(result.bitmapBytes>=int(sizeof(BITMAP))){result.width=info.dsBm.bmWidth;result.height=info.dsBm.bmHeight;}
            result.dib=result.bitmapBytes==sizeof(DIBSECTION)&&info.dsBm.bmBits!=nullptr;}
        return result;
    }
    void PublishLayoutDrag()noexcept{
        const HWND main=app_.MainWindow();
        layoutDrag_.store(main&&GetCapture()==main&&(app_.SidebarResizeDragging()!=0||app_.bottomPanelSizing.dragging>=0),std::memory_order_release);
    }
    Facts ReadFacts(HWND window,HDC dc,bool readWindow,bool unicode)noexcept{
        Facts result;LARGE_INTEGER qpc{};QueryPerformanceCounter(&qpc);result.qpc=qpc.QuadPart;
        result.thread=GetCurrentThreadId();result.lastError=GetLastError();result.focus=Bits(GetFocus());result.capture=Bits(GetCapture());
        result.foreground=Bits(GetForegroundWindow());result.alive=readWindow&&IsWindow(window);
        // QUERYUISTATE is a read-only native query. Its own transparent passage
        // is deliberately excluded from this trace to prevent self-recursion.
        if(result.alive){++factsDepth_;result.ui=unicode?SendMessageW(window,WM_QUERYUISTATE,0,0):SendMessageA(window,WM_QUERYUISTATE,0,0);--factsDepth_;result.uiAvailable=true;}
        const HWND main=app_.MainWindow();result.sidebarDragging=app_.SidebarResizeDragging()!=0;
        result.bottomIndex=app_.bottomPanelSizing.dragging;result.bottomDragging=result.bottomIndex>=0;
        result.bottomRelayout=app_.bottomPanelSizing.relayout;result.sidebarWidth=app_.SidebarWidth();
        result.mainCapture=main&&result.capture==Bits(main);result.layoutDragging=result.mainCapture&&(result.sidebarDragging||result.bottomDragging);
        result.mainClientKnown=main&&GetClientRect(main,&result.mainClient)!=FALSE;
        layoutDrag_.store(result.layoutDragging,std::memory_order_release);
        result.dc=DcFacts(dc);return result;
    }
    void Notify(Event& event)noexcept{
        if(event.message==WM_NOTIFY&&event.lp){NMHDR header{};
            if(Copy(reinterpret_cast<const void*>(event.lp),header)){
                event.notifyHeader=true;event.source=Bits(header.hwndFrom);event.sourceId=header.idFrom;event.notifyCode=header.code;
                if(header.code==NM_CUSTOMDRAW){NMCUSTOMDRAW draw{};if(Copy(reinterpret_cast<const void*>(event.lp),draw)){
                    event.customDraw=true;event.suppliedDc=Bits(draw.hdc);event.drawStage=draw.dwDrawStage;
                    event.item=draw.dwItemSpec;event.itemState=draw.uItemState;event.drawRect=draw.rc;}}
            }
        }else if(event.message==WM_CTLCOLORSTATIC){event.source=std::uintptr_t(event.lp);event.suppliedDc=std::uintptr_t(event.wp);}
        else if(event.message==WM_HSCROLL||event.message==WM_VSCROLL||event.message==WM_COMMAND){
            event.source=std::uintptr_t(event.lp);if(event.lp&&IsWindow(reinterpret_cast<HWND>(event.lp)))
                event.sourceId=UINT_PTR(GetDlgCtrlID(reinterpret_cast<HWND>(event.lp)));}
        else if(event.message==WM_ERASEBKGND||event.message==WM_PRINTCLIENT||event.message==WM_PRINT||event.message==WM_PAINT)
            event.suppliedDc=std::uintptr_t(event.wp);
    }
    static LONG_PTR CurrentProc(HWND window,bool unicode)noexcept{return unicode?GetWindowLongPtrW(window,GWLP_WNDPROC):GetWindowLongPtrA(window,GWLP_WNDPROC);}
    static LONG_PTR SetProc(HWND window,bool unicode,WNDPROC proc)noexcept{return unicode?SetWindowLongPtrW(window,GWLP_WNDPROC,reinterpret_cast<LONG_PTR>(proc)):SetWindowLongPtrA(window,GWLP_WNDPROC,reinterpret_cast<LONG_PTR>(proc));}
    static LRESULT Forward(WNDPROC original,bool unicode,HWND window,UINT message,WPARAM wp,LPARAM lp){
        return unicode?CallWindowProcW(original,window,message,wp,lp):CallWindowProcA(original,window,message,wp,lp);
    }
    static LRESULT CALLBACK Observe(HWND window,UINT message,WPARAM wp,LPARAM lp){
        const DWORD beforeError=GetLastError();Route* route=nullptr;
        for(auto& candidate:Routes())if(candidate.window==window){route=&candidate;break;}
        // Every installed observer has a route. This fallback is only defensive
        // against unsupported external procedure-chain corruption.
        if(!route){const bool unicode=IsWindowUnicode(window)!=FALSE;SetLastError(beforeError);
            return unicode?DefWindowProcW(window,message,wp,lp):DefWindowProcA(window,message,wp,lp);}
        const WNDPROC original=route->original;const bool unicode=route->unicode;Trace* const trace=route->trace;
        if(!trace){SetLastError(beforeError);const auto result=Forward(original,unicode,window,message,wp,lp);const DWORD nativeError=GetLastError();
            if(message==WM_NCDESTROY)*route={};SetLastError(nativeError);return result;}
        auto& self=*trace;auto& watch=self.watches_[route->index];self.PublishLayoutDrag();
        if(self.factsDepth_||!Interesting(message)||GetCurrentThreadId()!=self.ownerThread_){SetLastError(beforeError);
            const auto result=Forward(original,unicode,window,message,wp,lp);const DWORD nativeError=GetLastError();self.PublishLayoutDrag();
            if(message==WM_NCDESTROY){watch.installed=false;*route={};}SetLastError(nativeError);return result;}
        const auto sequence=++self.next_,parent=self.active_;
        const auto index=std::size_t((sequence-1)%kCapacity);auto& event=self.storage_[index];event={};
        event.sequence=sequence;event.parent=parent;event.depth=++self.depth_;event.phase=self.phase_.load(std::memory_order_relaxed);
        event.window=Bits(window);event.id=watch.id;event.message=message;event.wp=wp;event.lp=lp;
        event.sendFlags=InSendMessageEx(nullptr);event.messageTime=DWORD(GetMessageTime());event.extraInfo=GetMessageExtraInfo();self.Notify(event);
        event.entry=self.ReadFacts(window,reinterpret_cast<HDC>(event.suppliedDc),true,unicode);event.entry.lastError=beforeError;
        self.active_=sequence;
        if(Input(message))self.inputCount_.fetch_add(1,std::memory_order_release);
        self.sequence_.store(sequence,std::memory_order_release);
        struct Restore {Trace& trace;std::uint64_t parent;~Restore(){trace.active_=parent;--trace.depth_;}}restore{self,parent};
        SetLastError(beforeError);
        const auto result=Forward(original,unicode,window,message,wp,lp); // Exactly one original dispatch, with its original encoding.
        const DWORD nativeError=GetLastError();
        // A long synchronous nested message loop may wrap this slot. Never
        // overwrite the newer event when the old outer message finally returns.
        auto& returned=self.storage_[index];
        if(returned.sequence==sequence){returned.result=result;returned.returned=true;
            returned.exit=self.ReadFacts(window,reinterpret_cast<HDC>(returned.suppliedDc),message!=WM_NCDESTROY,unicode);returned.exit.lastError=nativeError;
            if(message==WM_CTLCOLORSTATIC&&result){LOGBRUSH brush{};returned.returnedBrush=std::uintptr_t(result);
                returned.brushKnown=GetObjectW(reinterpret_cast<HGDIOBJ>(result),sizeof(brush),&brush)==sizeof(brush);
                if(returned.brushKnown){returned.brushStyle=brush.lbStyle;returned.brushColor=brush.lbColor;}}
        }else ++self.overwrittenReturns_;
        self.PublishLayoutDrag();
        if(message==WM_NCDESTROY){watch.installed=false;*route={};}
        SetLastError(nativeError);return result;
    }
    static void DcColumns(std::ostream& file,const Dc& dc){
        file<<','<<dc.value<<','<<dc.type<<','<<dc.window<<','<<dc.mapMode<<','<<dc.clipKind<<','<<dc.clip.left<<','<<dc.clip.top<<','<<dc.clip.right<<','<<dc.clip.bottom
            <<','<<dc.originOk<<','<<dc.origin.x<<','<<dc.origin.y<<','<<dc.viewportOk<<','<<dc.viewport.x<<','<<dc.viewport.y
            <<','<<dc.windowOriginOk<<','<<dc.windowOrigin.x<<','<<dc.windowOrigin.y<<','<<dc.bitmap<<','<<dc.bitmapBytes<<','<<dc.width<<','<<dc.height<<','<<dc.dib;
    }
    static void DcHeader(std::ostream& file,const char* prefix){for(const char* field: {"dc","dc_type","dc_window","map_mode","clip_kind","clip_l","clip_t","clip_r","clip_b",
        "origin_ok","origin_x","origin_y","viewport_ok","viewport_x","viewport_y","window_origin_ok","window_origin_x","window_origin_y","bitmap","bitmap_bytes","bitmap_w","bitmap_h","dib"})
            file<<','<<prefix<<field;}
    static void LayoutHeader(std::ostream& file,const char* prefix){for(const char* field:{"sidebar_dragging","bottom_dragging","bottom_index","bottom_relayout","main_capture","layout_dragging","sidebar_width","main_client_known","main_client_l","main_client_t","main_client_r","main_client_b"})file<<','<<prefix<<field;}
    static void LayoutColumns(std::ostream& file,const Facts& facts){file<<','<<facts.sidebarDragging<<','<<facts.bottomDragging<<','<<facts.bottomIndex<<','<<facts.bottomRelayout
        <<','<<facts.mainCapture<<','<<facts.layoutDragging<<','<<facts.sidebarWidth<<','<<facts.mainClientKnown
        <<','<<facts.mainClient.left<<','<<facts.mainClient.top<<','<<facts.mainClient.right<<','<<facts.mainClient.bottom;}
public:
    explicit Trace(mikudancestudio::MMDApp& app):app_(app){}
    ~Trace(){Detach();}
    Trace(const Trace&)=delete;Trace& operator=(const Trace&)=delete;
    bool Attach(){
        if(attached_)return true;
        if(GetCurrentThreadId()!=ownerThread_||!app_.MainWindow()||GetWindowThreadProcessId(app_.MainWindow(),nullptr)!=ownerThread_){attachError_=ERROR_INVALID_THREAD_ID;return false;}
        // One active observer per UI thread. Pending pass-through routes from an
        // unsupported later outer subclass are not reused while still alive.
        for(auto& route:Routes()){if(route.window&&!IsWindow(route.window))route={};if(route.window){attachError_=ERROR_BUSY;return false;}}
        watches_[0]={app_.MainWindow(),0,false};
        for(unsigned i=0;i<kIds.size();++i)watches_[i+1]={GetDlgItem(app_.MainWindow(),kIds[i]),kIds[i],false};
        for(unsigned i=0;i<watches_.size();++i){auto& watch=watches_[i];
            if(!watch.window||!IsWindow(watch.window)||GetWindowThreadProcessId(watch.window,nullptr)!=ownerThread_){attachError_=ERROR_INVALID_WINDOW_HANDLE;Detach();return false;}
            watch.unicodeBefore=IsWindowUnicode(watch.window)!=FALSE;
            auto& route=Routes()[i];route={watch.window,reinterpret_cast<WNDPROC>(CurrentProc(watch.window,watch.unicodeBefore)),this,i,watch.unicodeBefore};
            if(!route.original){route={};attachError_=ERROR_INVALID_FUNCTION;Detach();return false;}
            SetLastError(ERROR_SUCCESS);const auto previous=SetProc(watch.window,watch.unicodeBefore,Observe);const DWORD error=GetLastError();
            if(!previous){route={};attachError_=error?error:ERROR_INVALID_FUNCTION;Detach();return false;}
            route.original=reinterpret_cast<WNDPROC>(previous);
            watch.installed=true;
            watch.unicodeAfter=IsWindowUnicode(watch.window)!=FALSE;
            if(watch.unicodeBefore!=watch.unicodeAfter){attachError_=ERROR_INVALID_DATA;Detach();return false;}
        }
        attachError_=ERROR_SUCCESS;attached_=true;PublishLayoutDrag();return true;
    }
    void Detach()noexcept{
        // Lifecycle is UI-thread-only; the capture thread only reads atomics.
        if(GetCurrentThreadId()!=ownerThread_)return;
        const DWORD beforeError=GetLastError();
        for(unsigned i=0;i<watches_.size();++i){auto& watch=watches_[i];auto& route=Routes()[i];
            if(!watch.installed||route.trace!=this)continue;
            bool removed=!route.window||!IsWindow(route.window);
            if(!removed&&CurrentProc(route.window,route.unicode)==reinterpret_cast<LONG_PTR>(Observe)){
                SetLastError(ERROR_SUCCESS);removed=SetProc(route.window,route.unicode,route.original)!=0;
                if(!removed)detachError_=GetLastError();
            }
            if(removed)route={};else{++detachConflicts_;route.trace=nullptr;}
            watch.installed=false;
        }
        attached_=false;layoutDrag_.store(false,std::memory_order_release);SetLastError(beforeError);
    }
    std::uint64_t Sequence()const noexcept{return sequence_.load(std::memory_order_acquire);}
    const std::atomic<std::uint64_t>* SequenceAddress()const noexcept{return &sequence_;}
    const std::atomic<bool>* LayoutDragAddress()const noexcept{return &layoutDrag_;}
    std::uint64_t InputCount()const noexcept{return inputCount_.load(std::memory_order_acquire);}
    void SetPhase(unsigned phase)noexcept{phase_.store(phase,std::memory_order_release);}
    void Write(const std::filesystem::path& output)const{
        if(attached_||depth_||GetCurrentThreadId()!=ownerThread_)throw std::logic_error("detach real-input metadata on its UI thread before writing");
        std::filesystem::create_directories(output);std::ofstream report(output/"real-input-metadata.txt"),csv(output/"real-input-metadata.csv");
        if(!report||!csv)throw std::runtime_error("open real input fixed-ring metadata output");
        LARGE_INTEGER frequency{};QueryPerformanceFrequency(&frequency);
        const auto first=next_>kCapacity?next_-kCapacity+1:1;
        report<<"Read-only main+13 native HWND metadata; capacity="<<kCapacity<<" total_entered="<<next_<<" first_retained="<<first
            <<" overwritten_entries="<<(next_>kCapacity?next_-kCapacity:0)<<" overwrittenCount="<<(next_>kCapacity?next_-kCapacity:0)<<" overwritten_returns="<<overwrittenReturns_
            <<" input_count="<<InputCount()<<" owner_thread="<<ownerThread_<<" attach_error="<<attachError_<<" detach_error="<<detachError_<<" detach_conflicts="<<detachConflicts_<<" qpc_frequency="<<frequency.QuadPart<<'\n'
            <<"Sequence means latest entered observed message, not latest returned message. Phase0=waiting,phase1=armed capture,phase2=finish. This is observational metadata, never an automatic no-flicker PASS. "
            "InputCount counts only observed mouse movement/button messages through these actual window procedures; "
            "no synthetic messages are generated, but receipt does not authenticate physical hardware or exclude SendMessage/injected input. GetMessageTime/ExtraInfo/InSendMessageEx are raw metadata only. "
            "Callbacks perform fixed POD/DC queries and read-only QUERYUISTATE (self queries not logged), one CallWindowProcA/W call matching each window's captured encoding, and restore its LastError/result. No files, allocation, GetDC, pixel sampling or input driving occur in callbacks. "
            "DC/clip/origin are raw caller-context data, not asserted physical coordinates. Parent WM_PRINTCLIENT is explicitly observed; absence of an event in this retained interval is not proof a different native drawing route did not run.\n";
        report<<"Timer coverage includes WM_TIMER(0x0113) and observed WM_SYSTIMER(0x0118), plus hover/leave, focus, UI-state and paint messages on the attached main/13 HWNDs. "
            "The observer neither creates timers nor changes timer IDs, delivery, native processing or results.\n";
        report<<"Layout-drag signal is sampled on callback entry and return: capture==main HWND && (SidebarResizeDragging!=0 || bottomPanelSizing.dragging>=0). "
            "bottomPanelSizing.relayout is recorded separately and is not treated as a drag. CSV records entry/return flags, bottom index, sidebar width and main client rectangle; "
            "main client dimensions may remain constant while internal child layout changes. Size/window-position, sizing, move and cursor messages are observed. "
            "Capture threads read only the published bool, not MMDApp/UI-thread state; atomic addresses must remain alive until recorder stop/join.\n";
        unsigned encodingChanges=0;
        for(const auto& watch:watches_){const bool changed=watch.unicodeBefore!=watch.unicodeAfter;encodingChanges+=changed;
            report<<"ATTACH id="<<watch.id<<" unicode_before="<<watch.unicodeBefore<<" unicode_after="<<watch.unicodeAfter
                <<" diagnostic_perturbation="<<changed<<'\n';}
        report<<"attach_encoding_changes="<<encodingChanges<<". Each window uses matching SetWindowLongPtrA/W and CallWindowProcA/W; an observed encoding change rejects Attach. "
            "Detach restores only an observer still at the head of its chain. A later outer subclass is not overwritten; its fixed forwarding slot drops the Trace pointer and the conflict is reported. "
            "Additional native queries and tracing overhead can affect timing; transparent result forwarding is not a claim of an entirely unperturbed execution.\n";
        csv<<"sequence,parent_sequence,depth,phase,hwnd,id,message,wparam,lparam,result,returned,entry_qpc,exit_qpc,entry_thread,exit_thread,entry_last_error,exit_last_error,send_flags,message_time,extra_info,"
            "entry_focus,exit_focus,entry_capture,exit_capture,entry_foreground,exit_foreground,entry_alive,exit_alive,entry_ui_available,entry_ui,exit_ui_available,exit_ui,"
            "notify_header,customdraw,source_hwnd,source_id,notify_code,draw_stage,item,item_state,draw_l,draw_t,draw_r,draw_b,returned_brush,brush_known,brush_style,brush_color";
        LayoutHeader(csv,"entry_");LayoutHeader(csv,"exit_");DcHeader(csv,"entry_");DcHeader(csv,"exit_");csv<<'\n';
        for(auto sequence=first;sequence<=next_;++sequence){const auto& e=storage_[std::size_t((sequence-1)%kCapacity)];if(e.sequence!=sequence)continue;
            csv<<e.sequence<<','<<e.parent<<','<<e.depth<<','<<e.phase<<','<<e.window<<','<<e.id<<','<<e.message<<','<<e.wp<<','<<e.lp<<','<<e.result<<','<<e.returned
                <<','<<e.entry.qpc<<','<<e.exit.qpc<<','<<e.entry.thread<<','<<e.exit.thread<<','<<e.entry.lastError<<','<<e.exit.lastError<<','<<e.sendFlags<<','<<e.messageTime<<','<<e.extraInfo
                <<','<<e.entry.focus<<','<<e.exit.focus<<','<<e.entry.capture<<','<<e.exit.capture<<','<<e.entry.foreground<<','<<e.exit.foreground<<','<<e.entry.alive<<','<<e.exit.alive
                <<','<<e.entry.uiAvailable<<','<<e.entry.ui<<','<<e.exit.uiAvailable<<','<<e.exit.ui<<','<<e.notifyHeader<<','<<e.customDraw<<','<<e.source<<','<<e.sourceId
