void RunJournalNameOwnership() {
    // The temporary journal name is unowned if CREATE_NEW refuses it, and
    // becomes vacant again when the transaction publishes its live journal.
    constexpr char foreign[] = "unrelated file at the temporary journal name";
    constexpr char previous[] = "previous PMM bytes";
    constexpr char fresh[] = "fresh PMM bytes";
    for (const bool retained : {false, true}) {
        const auto dir = Directory(Wide(StorageId()));
        CHECK(fs::create_directory(dir));
        const auto target = dir / L"active.pmm", stage = dir / L"stage.pmm";
        const auto journal = fs::path(target.native() + L".mms-save.json");
        Write(target, previous);
        Write(stage, fresh);
        PluginProject data;
        fs::path foreignPath;
        bool reached = false, rejected = false;
        try {
            PublishProjectPair(target, stage, data, false, [&](unsigned step) {
                if (step != 0) return;
                foreignPath = target.native() + L".mms-" + Wide(data.saveId) + L".journal";
                CHECK(!fs::exists(foreignPath));
                Write(foreignPath, foreign);
                reached = true;
            }, retained);
        } catch (const std::runtime_error&) { rejected = true; }
        CHECK(reached && rejected && !fs::exists(journal));
        CHECK(ReadFile(target) == previous && ReadFile(stage) == fresh);
        CHECK(fs::exists(foreignPath) && ReadFile(foreignPath) == foreign);
        CHECK(std::distance(fs::directory_iterator(dir), fs::directory_iterator()) == 3);

        // A fresh save has a different ID. Interrupt after its real journal
        // move, then place an unrelated file at the now vacant source name.
        fs::path reusedName;
        reached = rejected = false;
        try {
            PublishProjectPair(target, stage, data, false, [&](unsigned step) {
                if (step != 1) return;
                reusedName = target.native() + L".mms-" + Wide(data.saveId) + L".journal";
                CHECK(reusedName != foreignPath && !fs::exists(reusedName) && fs::exists(journal));
                Write(reusedName, foreign);
                reached = true;
                throw std::runtime_error("interrupt after publishing the recovery journal");
            }, retained);
        } catch (const std::runtime_error&) { rejected = true; }
        CHECK(reached && rejected && fs::exists(journal));
        for (unsigned attempt = 0; attempt < 2; ++attempt) {
            RecoverProjectPair(target);
            CHECK(!fs::exists(journal) && ReadFile(target) == fresh && ReadFile(stage) == fresh);
            CHECK(ReadPluginProject(target).mainHash == FileHash(target));
            CHECK(ReadFile(foreignPath) == foreign && ReadFile(reusedName) == foreign);
            if (retained) CHECK(ReadFile(target.native() + L"1") == previous);
            CHECK(!fs::exists(target.native() + L"11"));
        }
    }
    std::cout << "PASS SAVE-01 foreign temporary-journal names survive failed publication and recovery"
              << std::endl;
}

enum class DecisionFault { Pinned, BeforeOpen, ShortWrite };
struct DecisionSwap {
    fs::path journal, parked, incoming;
    DecisionFault fault;
    DWORD error = ERROR_SUCCESS;
    bool attempted = false, moved = false, installed = false;
};
DecisionSwap* decisionSwap = nullptr;
decltype(&WriteFile) originalDecisionWrite;
decltype(&CreateFileW) originalDecisionOpen;

void AttemptDecisionSwap() {
    auto& swap = *decisionSwap;
    CHECK(!swap.attempted);
    swap.attempted = true;
    swap.moved = originalMove(swap.journal.c_str(), swap.parked.c_str(), MOVEFILE_WRITE_THROUGH) != FALSE;
    if (swap.moved)
        swap.installed = originalMove(swap.incoming.c_str(), swap.journal.c_str(), MOVEFILE_WRITE_THROUGH) != FALSE;
    swap.error = (!swap.moved || !swap.installed) ? GetLastError() : ERROR_SUCCESS;
}

BOOL WINAPI SwapBeforeDecisionRename(LPCWSTR from, LPCWSTR to, DWORD flags) {
    if (decisionSwap && to && decisionSwap->journal == to && (flags & MOVEFILE_REPLACE_EXISTING))
        AttemptDecisionSwap();
    return originalMove(from, to, flags);
}

HANDLE WINAPI SwapBeforeDecisionOpen(LPCWSTR name, DWORD access, DWORD share, LPSECURITY_ATTRIBUTES security,
                                     DWORD disposition, DWORD flags, HANDLE templateFile) {
    if (decisionSwap && decisionSwap->fault == DecisionFault::BeforeOpen && name &&
        decisionSwap->journal == name && (access & GENERIC_WRITE) && disposition == OPEN_EXISTING)
        AttemptDecisionSwap();
    return originalDecisionOpen(name, access, share, security, disposition, flags, templateFile);
}

BOOL WINAPI SwapBeforeDecisionWrite(HANDLE file, LPCVOID bytes, DWORD count, LPDWORD written, LPOVERLAPPED overlap) {
    if (decisionSwap && std::string_view(static_cast<const char*>(bytes), count) == "MMS-SAVE-FORWARD\n") {
        if (decisionSwap->fault == DecisionFault::ShortWrite) {
            decisionSwap->attempted = true;
            return originalDecisionWrite(file, bytes, count / 2, written, overlap);
        }
        AttemptDecisionSwap();
    }
    return originalDecisionWrite(file, bytes, count, written, overlap);
}

int RunDecisionIdentity() {
    constexpr char previous[] = "previous active PMM";
    constexpr char fresh[] = "new staged PMM";
    constexpr char foreign[] = "unrelated file arriving at recovery record path";
    for (const bool original : {false, true}) for (const auto fault :
         {DecisionFault::Pinned, DecisionFault::BeforeOpen, DecisionFault::ShortWrite}) {
        const auto dir = Directory(Wide(StorageId()));
        CHECK(fs::create_directory(dir));
        const auto target = dir / L"active.pmm", stage = dir / L"stage.pmm", emm = dir / L"active.emm";
        Write(target, previous);
        Write(stage, fresh);
        Write(emm, "original active EMM");
        const auto before = ObserveChain(target);
        DecisionSwap swap{target.native() + L".mms-save.json", dir / L"parked-record.json", dir / L"incoming.json", fault};
        Write(swap.incoming, foreign);
        bool saved = false;
        {
            CHECK(MH_Initialize() == MH_OK);
            struct Hooks { ~Hooks() { decisionSwap = nullptr; MH_Uninitialize(); } } hooks;
            auto* move = reinterpret_cast<void*>(&MoveFileExW);
            auto* write = reinterpret_cast<void*>(&WriteFile);
            auto* open = reinterpret_cast<void*>(&CreateFileW);
            CHECK(MH_CreateHook(open, reinterpret_cast<void*>(&SwapBeforeDecisionOpen),
                reinterpret_cast<void**>(&originalDecisionOpen)) == MH_OK);
            CHECK(MH_CreateHook(move, reinterpret_cast<void*>(&SwapBeforeDecisionRename),
                reinterpret_cast<void**>(&originalMove)) == MH_OK);
            CHECK(MH_CreateHook(write, reinterpret_cast<void*>(&SwapBeforeDecisionWrite),
                reinterpret_cast<void**>(&originalDecisionWrite)) == MH_OK);
            CHECK(MH_EnableHook(MH_ALL_HOOKS) == MH_OK);
            decisionSwap = &swap;
            if (original) saved = mikumikustudio::pmm_versions::Publish(stage, target);
            else {
                PluginProject data;
                try {
                    PublishProjectPair(target, stage, data, false, {}, true);
                    saved = true;
                } catch (const std::runtime_error& error) {
                    CHECK(fault != DecisionFault::Pinned);
                    CHECK(std::string_view(error.what()) == (fault == DecisionFault::BeforeOpen
                        ? "retention journal was replaced" : "short recovery decision write (Win32 29)"));
                }
            }
        }
        std::cout << "SAVE-01 decision profile=" << (original ? "schema3" : "schema2")
                  << " boundary=" << static_cast<int>(fault) << " saved=" << saved
                  << " attempted=" << swap.attempted << " moved=" << swap.moved
                  << " installed=" << swap.installed << " Win32=" << swap.error << std::endl;
        CHECK(swap.attempted);
        if (fault == DecisionFault::Pinned) {
            CHECK(saved && !swap.moved && swap.error == ERROR_SHARING_VIOLATION);
            CHECK(ReadFile(swap.incoming) == foreign && !fs::exists(swap.parked));
            CHECK(ReadFile(target) == fresh && ReadFile(target.native() + L"1") == previous);
            CHECK(ReadFile(emm) == "original active EMM" && ReadFile(dir / L"active.emm1") == "original active EMM");
            if (!original) CHECK(ReadPluginProject(target).mainHash == FileHash(target));
        } else {
            CHECK(!saved && ReadFile(target) == previous && ReadFile(stage) == fresh);
            if (fault == DecisionFault::BeforeOpen) {
                CHECK(swap.moved && swap.installed && ReadFile(swap.journal) == foreign);
                bool rejected = false;
                try { RecoverProjectPair(target); }
                catch (const std::exception&) { rejected = true; }
                CHECK(rejected && ReadFile(swap.journal) == foreign && fs::exists(swap.parked));
                CHECK(MoveFileExW(swap.journal.c_str(), swap.incoming.c_str(), MOVEFILE_WRITE_THROUGH));
                CHECK(MoveFileExW(swap.parked.c_str(), swap.journal.c_str(), MOVEFILE_WRITE_THROUGH));
            } else {
                const auto bytes = ReadFile(swap.journal);
                const std::string_view token = "MMS-SAVE-FORWARD\n";
                CHECK(bytes.size() > token.size() && std::string_view(bytes).substr(bytes.size() - token.size()/2) ==
                    token.substr(0, token.size()/2));
            }
            for (int attempt = 0; attempt < 2; ++attempt) {
                RecoverProjectPair(target);
                CHECK(ObserveChain(target) == before && ReadFile(swap.incoming) == foreign);
            }
        }
        CHECK(!fs::exists(swap.journal) && !fs::exists(target.native() + L"11"));
    }
    std::cout << "PASS SAVE-01 decision write pins the recovery record and preserves the competing file" << std::endl;
    std::cout << "PASS SAVE-01 replaced and incomplete decision writes preserve the original project after retry" << std::endl;
    return 0;
}

int OriginalArchiveWriter(const std::wstring& id) {
    const auto dir = Directory(id), target = dir / L"active.pmm", stage = dir / L"stage.pmm";
    Handle notification(OpenEventW(EVENT_MODIFY_STATE, FALSE, ReadyName(id).c_str()));
    Handle parked(CreateEventW(nullptr, TRUE, FALSE, nullptr));
    Write(stage, "new interrupted PMM");
    ArmRenameBarrier(target.native() + L"1", target.native() + L"11", notification.value, parked.value);
    mikumikustudio::pmm_versions::Publish(stage, target);
    throw std::runtime_error("original writer did not stop at its archive rename");
}

struct ArchiveArrival {
    fs::path from, to, parked, incoming;
    bool destination = false;
    bool attempted = false, moved = false, installed = false;
    DWORD error = ERROR_SUCCESS;

    void Try() {
        CHECK(!attempted);
        attempted = true;
        if (!destination)
            moved = originalMove(from.c_str(), parked.c_str(), MOVEFILE_WRITE_THROUGH) != FALSE;
        if (destination || moved) {
            const auto& path = destination ? to : from;
            installed = originalMove(incoming.c_str(), path.c_str(), MOVEFILE_WRITE_THROUGH) != FALSE;
        }
        if (!installed) error = GetLastError();
    }
};
ArchiveArrival* archiveArrival = nullptr;
decltype(&SetFileInformationByHandle) originalArchiveSet = nullptr;

BOOL WINAPI ObserveArchiveMove(LPCWSTR from, LPCWSTR to, DWORD flags) {
    auto* arrival = archiveArrival;
    if (arrival && !arrival->attempted && from && to && arrival->from == from && arrival->to == to)
        arrival->Try();
    return originalMove(from, to, flags);
}

BOOL WINAPI ObserveArchiveSet(HANDLE file, FILE_INFO_BY_HANDLE_CLASS type, LPVOID data, DWORD size) {
    auto* arrival = archiveArrival;
    if (arrival && !arrival->attempted &&
        save_journal_fixture::MatchesHandleRename(file, type, data, size, arrival->from, arrival->to))
        arrival->Try();
    return originalArchiveSet(file, type, data, size);
}

int RunArchiveIdentity() {
    constexpr char oldPmm[] = "oldest retained PMM";
    constexpr char middlePmm[] = "middle retained PMM";
    constexpr char freshPmm[] = "new interrupted PMM";
    constexpr char foreign[] = "independent file arriving during an archive rename";
    unsigned misplaced = 0;
    for (bool original : {false, true}) for (bool rollback : {false, true}) for (bool destination : {false, true}) {
        const auto id = Wide(StorageId());
        const auto dir = Directory(id), target = dir / L"active.pmm", stage = dir / L"stage.pmm";
        CHECK(fs::create_directory(dir));
        std::cout << "SAVE-01 archive-identity fixture=" << Utf8(dir.native()) << std::endl;
        if (original) {
            Write(target, oldPmm);
            Write(mikumikustudio::pmm_paths::Effect(target), "oldest EMM");
            Write(stage, middlePmm);
            CHECK(mikumikustudio::pmm_versions::Publish(stage, target));
            Write(mikumikustudio::pmm_paths::Effect(target), "middle EMM");
        } else SeedRetainedPair(target, stage);
        const auto before = ObserveChain(target);
        CHECK(before[0][0] == middlePmm && before[1][0] == oldPmm && before[2] == Level{});
        const fs::path prior = target.native() + L"1", oldest = target.native() + L"11";
        const fs::path journal = target.native() + L".mms-save.json";
        auto interruptedChain = before;
        std::string record;
        if (rollback) {
            const HANDLE event = CreateEventW(nullptr, TRUE, FALSE, ReadyName(id).c_str());
            const DWORD error = GetLastError();
            Handle barrier(event);
            CHECK(error != ERROR_ALREADY_EXISTS);
            Child writer(original ? L"--version-storage-original-archive-write" : L"--version-storage-crash-write", id, dir);
            writer.AwaitBarrier(barrier.value);
            interruptedChain[2][0] = interruptedChain[1][0];
            interruptedChain[1][0].reset();
            CHECK(ObserveChain(target) == interruptedChain);
            record = ReadFile(journal);
            const auto parsed = save_journal_fixture::Parse(record);
            CHECK(parsed.At("schemaVersion").UInt() == (original ? 3u : 2u));
            CHECK(parsed.At("decision").String() == "rollback");
            writer.Interrupt();
            CHECK(writer.Join() == interrupted && ReadFile(journal) == record);
        } else Write(stage, freshPmm);
        ArchiveArrival arrival{rollback ? oldest : prior, rollback ? prior : oldest,
            dir / L"parked-original.pmm", dir / L"incoming.pmm", destination};
        Write(arrival.incoming, foreign);
        PluginProject fresh;
        if (!original && !rollback) fresh = ReadPluginProject(target);
        const auto publish = [&] {
            if (original) return mikumikustudio::pmm_versions::Publish(stage, target);
            PublishProjectPair(target, stage, fresh, false, {}, true);
            return true;
        };
        bool ok = false;
        {
            CHECK(MH_Initialize() == MH_OK);
            struct Hooks { ~Hooks() { archiveArrival = nullptr; MH_Uninitialize(); } } hooks;
            auto* move = reinterpret_cast<void*>(&MoveFileExW);
            auto* set = reinterpret_cast<void*>(&SetFileInformationByHandle);
            CHECK(MH_CreateHook(move, reinterpret_cast<void*>(&ObserveArchiveMove),
                reinterpret_cast<void**>(&originalMove)) == MH_OK);
            CHECK(MH_CreateHook(set, reinterpret_cast<void*>(&ObserveArchiveSet),
                reinterpret_cast<void**>(&originalArchiveSet)) == MH_OK);
            CHECK(MH_EnableHook(MH_ALL_HOOKS) == MH_OK);
            archiveArrival = &arrival;
            try {
                if (rollback) {
                    RecoverProjectPair(target);
                    ok = true;
                } else ok = publish();
            } catch (const std::runtime_error&) {}
        }
        const auto atDestination = ObserveFile(arrival.to);
        std::cout << "SAVE-01 archive profile=" << (original ? "schema3" : "schema2")
                  << " operation=" << (rollback ? "rollback" : "forward")
                  << " conflict=" << (destination ? "late-destination" : "source-replacement")
                  << " attempted=" << arrival.attempted << " moved=" << arrival.moved
                  << " installed=" << arrival.installed << " Win32=" << arrival.error
                  << " operation_ok=" << ok << " foreign_at_destination=" << (atDestination == foreign)
                  << " journal=" << fs::exists(journal) << std::endl;
        CHECK(arrival.attempted);
        if (!destination && arrival.installed) {
            CHECK(!ok && arrival.moved && atDestination == foreign && fs::exists(journal));
            CHECK(ReadFile(arrival.parked) == oldPmm);
            ++misplaced;
            continue;
        }
        if (destination) {
            CHECK(!ok && !arrival.moved && arrival.installed && atDestination == foreign);
            CHECK(ReadFile(arrival.from) == oldPmm && fs::exists(journal));
            if (rollback) CHECK(ReadFile(journal) == record);
            CHECK(MoveFileExW(arrival.to.c_str(), arrival.incoming.c_str(), MOVEFILE_WRITE_THROUGH));
            CHECK(ObserveChain(target) == interruptedChain);
            RecoverProjectPair(target);
            CHECK(ObserveChain(target) == before && !fs::exists(journal));
            if (!rollback) CHECK(publish());
        } else {
            CHECK(ok && !arrival.moved && !arrival.installed && !fs::exists(arrival.parked));
            CHECK(arrival.error == ERROR_SHARING_VIOLATION || arrival.error == ERROR_ACCESS_DENIED);
        }
        CHECK(ReadFile(arrival.incoming) == foreign);
        Chain expected = before;
        if (!rollback) {
            expected[2] = before[1];
            expected[1] = before[0];
            expected[0][0] = freshPmm;
            if (!original) expected[0][2] = EncodeProject(fresh);
        }
        for (int pass = 0; pass < 2; ++pass) {
            RecoverProjectPair(target);
            CHECK(ObserveChain(target) == expected && !fs::exists(journal));
        }
    }
    CHECK(misplaced == 0);
    std::cout << "PASS SAVE-01 archive rename preserves source identity and late arrivals in both profiles" << std::endl;
    return 0;
}

int Run() {
    RunJournalNameOwnership();
    RunPrepublicationCleanupIdentity();
    RunJournalReplacement();
    RunCase(false);
    RunCase(true);
    for (unsigned boundary = 1; boundary <= 6; ++boundary) RunRecoveryCase(false, boundary);
    for (unsigned boundary = 1; boundary <= 2; ++boundary) RunRecoveryCase(true, boundary);
    // A forward decision with a half-rotated archive cannot result from a
    // normal publisher hard stop: Align(true) and Verify(true) precede
    // ChangeDecision. Exercise the real remaining PMM/sidecar publication
    // instead of manufacturing that unreachable journal/chain combination.
    std::cout << "PASS SAVE-01 retained pair hard interruption" << std::endl;
    // A real read-only cleanup stage must be reported and must keep the
    // durable journal; two fresh processes then finish the same decision.
    RunReadOnlyCleanupRecoveryCase();
    // A sharing-denied recovered old EMM stage: the corrected cleanup removes
    // the regular stages first, checks the EMM stage next, and deletes the
    // durable journal last. Two fresh processes then finish the decision.
    RunDeniedEffectCleanupRecoveryCase();
    // The same sharing denial leaves the inherited READONLY unchanged.
    // Two fresh processes then finish the cleanup.
    RunDeniedEffectCleanupRecoveryCase(true);
    RunReplacedEffectCleanupRecoveryCase();
    RunStageCleanupIdentityCase();
    RunStageCleanupIdentityCase(CleanupMember::Effect);
    RunStageCleanupIdentityCase(CleanupMember::Journal);
    // Real sharing denial on an owned member, then fresh-process completion.
    RunDeniedRecoveryCase(true, false);  // forward-1: denied new sidecar publish
    RunDeniedRecoveryCase(true, true);   // forward-2: denied journal completion
    RunDeniedRecoveryCase(false, false); // rollback-4: denied fifth inverse move
    RunDeniedRecoveryCase(false, true);  // rollback-6: denied journal completion
    return 0;
}
