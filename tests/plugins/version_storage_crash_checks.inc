namespace version_storage_crash {
constexpr DWORD deadline = 60000;
constexpr DWORD interrupted = 73;

fs::path Directory(const std::wstring& id) {
    CHECK(id.size() == 32 && id.find_first_not_of(L"0123456789abcdef") == id.npos);
    return fs::absolute(fs::temp_directory_path()) / (L"mms-version-crash-" + id);
}
std::wstring ReadyName(const std::wstring& id) { return L"Local\\MMS-version-crash-" + id; }

struct Handle {
    HANDLE value;
    explicit Handle(HANDLE h) : value(h) { CHECK(value && value != INVALID_HANDLE_VALUE); }
    ~Handle() { CloseHandle(value); }
    Handle(const Handle&) = delete;
    Handle& operator=(const Handle&) = delete;
};

class Child {
    HANDLE process;
public:
    Child(const wchar_t* mode, const std::wstring& id, const fs::path& directory) {
        wchar_t exe[32768]{};
        const auto length = GetModuleFileNameW(nullptr, exe, 32768);
        CHECK(length && length < 32768);
        std::wstring command = L"\"" + std::wstring(exe) + L"\" " + mode + L" " + id;
        STARTUPINFOW startup{sizeof startup};
        PROCESS_INFORMATION info{};
        CHECK(CreateProcessW(exe, command.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW,
                             nullptr, directory.c_str(), &startup, &info));
        process = info.hProcess;
        CloseHandle(info.hThread);
    }
    Child(const Child&) = delete;
    Child& operator=(const Child&) = delete;
    ~Child() {
        if (WaitForSingleObject(process, 0) == WAIT_TIMEOUT && TerminateProcess(process, 74))
            WaitForSingleObject(process, deadline);
        CloseHandle(process);
    }
    void AwaitBarrier(HANDLE event) const {
        const HANDLE both[] = {event, process};
        CHECK(WaitForMultipleObjects(2, both, FALSE, deadline) == WAIT_OBJECT_0);
        CHECK(WaitForSingleObject(process, 0) == WAIT_TIMEOUT);
    }
    void Interrupt() const { CHECK(TerminateProcess(process, interrupted)); }
    DWORD Join() const {
        CHECK(WaitForSingleObject(process, deadline) == WAIT_OBJECT_0);
        DWORD code = STILL_ACTIVE;
        CHECK(GetExitCodeProcess(process, &code));
        std::cout << "SAVE-01 child pid=" << GetProcessId(process) << " exit=" << code << std::endl;
        return code;
    }
};

using Level = std::array<std::optional<std::string>, 3>;
using Chain = std::array<Level, 4>; // active, 1, 11, and an unwanted further rotation
Level Observe(const fs::path& target) {
    Level result{};
    const auto paths = VersionMembers(target);
    for (size_t i = 0; i < result.size(); ++i)
        if (fs::exists(paths[i])) result[i] = ReadFile(paths[i]);
    return result;
}
Chain ObserveChain(fs::path target) {
    Chain result{};
    for (auto& level : result) { level = Observe(target); target += L"1"; }
    return result;
}
void SaveOracle(const fs::path& path, const std::vector<std::string>& bytes) {
    const auto names = VersionMembers(path);
    CHECK(bytes.size() == names.size());
    for (size_t i = 0; i < names.size(); ++i) Write(names[i], bytes[i]);
}

static decltype(&MoveFileExW) originalMove;

void ArmRenameBarrier(const fs::path& from, const fs::path& to, HANDLE notification,
                      HANDLE parked) {
    save_journal_fixture::ArmRenameBarrier(from, to, notification, parked, deadline);
}

int Writer(const std::wstring& id, bool afterPublish) {
    const auto dir = Directory(id);
    Handle notification(OpenEventW(EVENT_MODIFY_STATE, FALSE, ReadyName(id).c_str()));
    Handle parked(CreateEventW(nullptr, TRUE, FALSE, nullptr));
    const auto target = dir / L"active.pmm", stage = dir / L"stage.pmm";
    auto project = ReadPluginProject(target);
    project.records["example.a"] = StoredInt(903);
    Write(stage, "new interrupted PMM");
    if (!afterPublish)
        ArmRenameBarrier(target.native() + L"1", target.native() + L"11", notification.value, parked.value);
    PublishProjectPair(target, stage, project, false, [&](unsigned step) {
        // Snapshot the candidate ID/payload generated by the real publisher,
        // before any version mutation, for an independent roll-forward oracle.
        if (step == 0) Write(dir / L"expected-new-side.json", EncodeProject(project));
        if (afterPublish && step == 2) {
            SignalObjectAndWait(notification.value, parked.value, deadline, FALSE);
            ExitProcess(75);
        }
    }, true);
    throw std::runtime_error("writer completed without the history rename barrier");
}

int Recovery(const std::wstring& id) {
    const auto dir = Directory(id), target = dir / L"active.pmm";
    const Level oldest = Observe(dir / L"oracle" / L"oldest.pmm");
    const Level middle = Observe(dir / L"oracle" / L"middle.pmm");
    const Level fresh{"new interrupted PMM", "middle EMM", ReadFile(dir / L"expected-new-side.json")};
    const Chain rolledBack{middle, oldest, Level{}, Level{}};
    const Chain rolledForward{fresh, middle, oldest, Level{}};
    const auto journal = target.native() + L".mms-save.json";
    const auto record = save_journal_fixture::Parse(ReadFile(journal));
    CHECK(record.At("schemaVersion").UInt() == 2 && record.At("effectStage").UInt() == 1);
    CHECK(record.At("versions").Items().size() == 3);
    for (const auto& row : record.At("versions").Items()) CHECK(row.Items().size() == 3);
    const auto decision = record.At("decision").String();
    CHECK(decision == "rollback" || decision == "forward");
    std::ofstream evidence(dir / L"recovery.txt");
    CHECK(evidence);
    auto recover = [&] {
        try { RecoverProjectPair(target); }
        catch (const std::exception& ex) { evidence << "recovery threw: " << ex.what() << std::endl; throw; }
        return ObserveChain(target);
    };
    const Chain first = recover();
    const bool finished = !fs::exists(journal);
    const Chain second = recover();
    const bool rollback = first == rolledBack, forward = first == rolledForward;
    evidence << "rollback=" << rollback << " forward=" << forward << " repeated_same=" << (second == first)
             << " journal_after_first=" << !finished << " journal_after_second=" << fs::exists(journal) << '\n';
    for (size_t i = 0; i < first.size(); ++i) {
        evidence << "level " << i << " PMM/EMM/side present:";
        for (const auto& member : first[i]) evidence << ' ' << member.has_value();
        evidence << '\n';
    }
    evidence.flush();
    CHECK(evidence);
    CHECK(decision == "forward" ? forward : rollback);
    CHECK(finished && !fs::exists(journal) && second == first);
    return 0;
}

void RunCase(bool afterPublish) {
    const auto id = Wide(StorageId());
    const auto dir = Directory(id), target = dir / L"active.pmm";
    CHECK(fs::create_directory(dir)); // Never reuse a previous run or accept a project path.
    std::cout << "SAVE-01 fixture=" << Utf8(dir.native()) << std::endl;
    const auto seed = SeedRetainedPair(target, dir / L"stage.pmm");
    SaveOracle(dir / L"oracle" / L"oldest.pmm", seed.oldest);
    SaveOracle(dir / L"oracle" / L"middle.pmm", seed.middle);
    const auto oldest = Observe(dir / L"oracle" / L"oldest.pmm");
    const auto middle = Observe(dir / L"oracle" / L"middle.pmm");
    const Chain before{middle, oldest, Level{}, Level{}};
    CHECK(ObserveChain(target) == before);
    const HANDLE event = CreateEventW(nullptr, TRUE, FALSE, ReadyName(id).c_str());
    const DWORD eventError = GetLastError();
    Handle barrier(event);
    CHECK(eventError != ERROR_ALREADY_EXISTS);
    Child writer(afterPublish ? L"--version-storage-crash-publish" : L"--version-storage-crash-write", id, dir);
    writer.AwaitBarrier(barrier.value);
    Chain split = before;
    if (afterPublish) {
        split[2] = oldest;
        split[1] = middle;
        split[0][0] = "new interrupted PMM";
    } else {
        split[2][0] = split[1][0];
        split[1][0].reset();
    }
    CHECK(ObserveChain(target) == split);
    const auto journal = fs::path(target.native() + L".mms-save.json");
    const auto record = ReadFile(journal);
    CHECK(save_journal_fixture::Parse(record).At("decision").String() == (afterPublish ? "forward" : "rollback"));
    std::cout << (afterPublish ? "verified paused writer: new PMM with old sidecar; journal="
                               : "verified paused writer: oldest PMM at 11, oldest EMM and sidecar at 1; journal=")
              << fs::exists(target.native() + L".mms-save.json") << std::endl;
    writer.Interrupt();
    CHECK(writer.Join() == interrupted);
    CHECK(ObserveChain(target) == split && ReadFile(journal) == record);
    Child recovery(L"--version-storage-crash-recover", id, dir);
    const DWORD code = recovery.Join();
    if (fs::exists(dir / L"recovery.txt")) std::cout << ReadFile(dir / L"recovery.txt") << std::flush;
    CHECK(code == 0);
    if (afterPublish) {
        split[0][2] = ReadFile(dir / L"expected-new-side.json");
        CHECK(ObserveChain(target) == split);
    } else CHECK(ObserveChain(target) == before);
}

// Full-profile recovery matrix. The scenario file selects only a barrier; it
// never supplies a production journal or mutates a transaction member.
struct RecoveryScenario {
    bool forward;
    unsigned boundary;
};
RecoveryScenario Scenario(const fs::path& dir) {
    const auto value = ReadFile(dir / L"recovery-case.txt");
    if (value.size() == 10 && value.compare(0, 9, "rollback-") == 0 && value[9] >= '1' && value[9] <= '6')
        return {false, unsigned(value[9] - '0')};
    CHECK(value.size() == 9 && value.compare(0, 8, "forward-") == 0 && value[8] >= '1' && value[8] <= '2');
    return {true, unsigned(value[8] - '0')};
}

struct RecoveryOracle {
    Level oldest, middle, fresh;
    explicit RecoveryOracle(const fs::path& dir)
        : oldest(Observe(dir / L"oracle" / L"oldest.pmm")),
          middle(Observe(dir / L"oracle" / L"middle.pmm")),
          fresh{"new interrupted PMM", "middle EMM", ReadFile(dir / L"expected-new-side.json")} {
        for (const auto* level : {&oldest, &middle, &fresh})
            for (const auto& member : *level) CHECK(member.has_value());
        CHECK(oldest[0] == "oldest retained PMM" && oldest[1] == "oldest EMM");
        CHECK(middle[0] == "middle retained PMM" && middle[1] == "middle EMM");
        const auto a = DecodeProject(*oldest[2]), b = DecodeProject(*middle[2]), c = DecodeProject(*fresh[2]);
        CHECK(a.projectId == b.projectId && b.projectId == c.projectId);
        CHECK(a.saveId != b.saveId && b.saveId != c.saveId && a.saveId != c.saveId);
        CHECK(a.records.size() == 1 && b.records.size() == 1 && c.records.size() == 1);
        CHECK(a.records.at("example.a").schema == 7 && b.records.at("example.a").schema == 7 &&
              c.records.at("example.a").schema == 7);
        CHECK(SavedInt(a.records.at("example.a")) == 901 && SavedInt(b.records.at("example.a")) == 902 &&
              SavedInt(c.records.at("example.a")) == 903);
        CHECK(a.mainHash == FileHash(dir / L"oracle" / L"oldest.pmm"));
        CHECK(b.mainHash == FileHash(dir / L"oracle" / L"middle.pmm"));
        CHECK(c.mainHash == FileHash(dir / L"stage.pmm"));
    }
    Chain Before() const { return {middle, oldest, Level{}, Level{}}; }
    Chain Pending() const { return {middle, middle, oldest, Level{}}; }
    Chain Forward() const { return {fresh, middle, oldest, Level{}}; }
    Chain Partial(const RecoveryScenario& scenario) const {
        // Explicit byte/absence expectations, not Archive's move planner or
        // an initial recovery run used as an oracle. EMM remains unchanged
        // in active; it participates in all historical generations.
        if (scenario.forward) {
            if (scenario.boundary == 1)
                return {Level{fresh[0], middle[1], middle[2]}, middle, oldest, Level{}};
            return Forward();
        }
        switch (scenario.boundary) {
        case 1: return {middle, Level{middle[0], middle[1], std::nullopt}, oldest, Level{}};
        case 2: return {middle, Level{middle[0], std::nullopt, std::nullopt}, oldest, Level{}};
        case 3: return {middle, Level{}, oldest, Level{}};
        case 4: return {middle, Level{std::nullopt, std::nullopt, oldest[2]},
                               Level{oldest[0], oldest[1], std::nullopt}, Level{}};
        case 5: return {middle, Level{std::nullopt, oldest[1], oldest[2]},
                               Level{oldest[0], std::nullopt, std::nullopt}, Level{}};
        case 6: return Before();
        }
        throw std::runtime_error("invalid rollback boundary");
    }
    Level RestoredStages(unsigned boundary) const {
        if (boundary == 1) return {std::nullopt, std::nullopt, middle[2]};
        if (boundary == 2) return {std::nullopt, middle[1], middle[2]};
        return middle;
    }
};

// These are the schema-2 full-profile names in project_storage.cpp, including
// its compact EMM stage. Do not use schema 3's two-member journal assumptions.
struct TransactionFiles {
    fs::path journal, newMain, newSide, oldMain, oldEffect, oldSide, tempJournal;
    TransactionFiles(const fs::path& target, const std::string& id) {
        CHECK(id.size() == 32 && id.find_first_not_of("0123456789abcdef") == id.npos);
        const auto base = target.native() + L".mms-" + Wide(id);
        journal = target.native() + L".mms-save.json";
        newMain = base + L".new-pmm"; newSide = base + L".new-json";
        oldMain = base + L".old-pmm"; oldSide = base + L".old-json";
        oldEffect = target.parent_path() / (L".mms-" + Wide(id) + L".old-emm");
        tempJournal = base + L".journal";
    }
};
TransactionFiles CheckJournal(const fs::path& dir, const std::string& record, bool forward) {
    const auto j = save_journal_fixture::Parse(record);
    CHECK(j.At("schemaVersion").UInt() == 2 && j.At("effectStage").UInt() == 1);
    CHECK(!j.object.count("members") && j.At("decision").String() == (forward ? "forward" : "rollback"));
    const auto& rows = j.At("versions").Items();
    CHECK(rows.size() == 3);
    const std::array<fs::path, 2> seeds{dir / L"oracle" / L"middle.pmm", dir / L"oracle" / L"oldest.pmm"};
    for (size_t level = 0; level < rows.size(); ++level) {
        const auto& values = rows[level].Items();
        CHECK(values.size() == 3);
        for (size_t member = 0; member < 3; ++member)
            CHECK(values[member].String() == (level == 2 ? std::string{} : FileHash(VersionMembers(seeds[level])[member])));
    }
    CHECK(j.At("oldMain").String() == rows[0].Items()[0].String());
    CHECK(j.At("oldSide").String() == rows[0].Items()[2].String());
    CHECK(j.At("newMain").String() == FileHash(dir / L"stage.pmm"));
    CHECK(j.At("newSide").String() == FileHash(dir / L"expected-new-side.json"));
    CHECK(j.At("newMain").String() != j.At("oldMain").String());
    CHECK(j.At("newSide").String() != j.At("oldSide").String());
    CHECK(j.At("saveId").String() == DecodeProject(ReadFile(dir / L"expected-new-side.json")).saveId);
    return TransactionFiles(dir / L"active.pmm", j.At("saveId").String());
}
std::optional<std::string> ObserveFile(const fs::path& path) {
    return fs::exists(path) ? std::optional<std::string>{ReadFile(path)} : std::nullopt;
}
void CheckStages(const TransactionFiles& files, const RecoveryOracle& oracle,
                 const RecoveryScenario& scenario, bool recoveryStarted) {
    const Level oldStages{ObserveFile(files.oldMain), ObserveFile(files.oldEffect), ObserveFile(files.oldSide)};
    CHECK(oldStages == (recoveryStarted && !scenario.forward ? oracle.RestoredStages(scenario.boundary) : Level{}));
    CHECK(ObserveFile(files.newMain) == (recoveryStarted && scenario.forward ? std::nullopt : oracle.fresh[0]));
    CHECK(ObserveFile(files.newSide) == (recoveryStarted && scenario.forward && scenario.boundary == 2 ?
                                      std::nullopt : oracle.fresh[2]));
    CHECK(!fs::exists(files.tempJournal));
}
// Journal-last cleanup: a denied journal deletion means every listed stage
// above the journal was already removed. The checked rollback EMM discard now
// also runs before journal deletion, so a journal-only denial has every stage
// absent; a forward recovery has no oldEffect stage either.
void CheckJournalCleanupStages(const TransactionFiles& files, const RecoveryOracle&, bool) {
    for (const auto* path : {&files.newMain, &files.oldMain, &files.tempJournal, &files.newSide, &files.oldSide})
        CHECK(!fs::exists(*path));
    CHECK(!fs::exists(files.oldEffect));
}
// Corrected cleanup order with a sharing-denied old EMM stage: the regular
// PMM and sidecar stages are already gone, while the checked EMM stage and
// the journal (deleted last) survive. Kept independent of the journal-denial
// snapshot above.
void CheckEffectCleanupDeniedStages(const TransactionFiles& files, const RecoveryOracle& oracle) {
    for (const auto* path : {&files.newMain, &files.oldMain, &files.tempJournal, &files.newSide, &files.oldSide})
        CHECK(!fs::exists(*path));
    CHECK(fs::exists(files.journal));
    CHECK(fs::is_regular_file(files.oldEffect));
    CHECK(ReadFile(files.oldEffect) == *oracle.middle[1]);
}
void CheckClean(const TransactionFiles& files) {
    for (const auto* path : {&files.journal, &files.newMain, &files.newSide, &files.oldMain,
                             &files.oldEffect, &files.oldSide, &files.tempJournal}) CHECK(!fs::exists(*path));
}
struct RenameBoundary { fs::path from, to; };
RenameBoundary RecoveryRename(const fs::path& target, const TransactionFiles& files, const RecoveryScenario& scenario) {
    if (scenario.forward)
        return scenario.boundary == 1 ? RenameBoundary{files.newMain, target} : RenameBoundary{files.newSide, PluginSidecar(target)};
    const auto one = VersionMembers(fs::path(target.native() + L"1"));
    const auto two = VersionMembers(fs::path(target.native() + L"11"));
    // Reverse of six actual three-member archive moves, with independent
    // expected bytes above. The first three restore private backup stages.
    const std::array<RenameBoundary, 6> operations{{
        {one[2], files.oldSide}, {one[1], files.oldEffect}, {one[0], files.oldMain},
        {two[2], one[2]}, {two[1], one[1]}, {two[0], one[0]}
    }};
    return operations[scenario.boundary - 1];
}

// Required wmain routes (argc == 3; argv[2] is the fixture ID):
// --version-storage-recovery-write     -> RecoveryWriter(argv[2])
// --version-storage-recovery-interrupt -> InterruptRecovery(argv[2])
// --version-storage-recovery-first     -> RetryRecovery(argv[2], 1)
// --version-storage-recovery-second    -> RetryRecovery(argv[2], 2)
int RecoveryWriter(const std::wstring& id) {
    const auto dir = Directory(id), target = dir / L"active.pmm", stage = dir / L"stage.pmm";
    const auto scenario = Scenario(dir);
    Handle notification(OpenEventW(EVENT_MODIFY_STATE, FALSE, ReadyName(id).c_str()));
    Handle parked(CreateEventW(nullptr, TRUE, FALSE, nullptr));
    auto project = ReadPluginProject(target);
    project.records["example.a"] = StoredInt(903);
    Write(stage, "new interrupted PMM");
    PublishProjectPair(target, stage, project, false, [&](unsigned step) {
        if (step != 0) return;
        // Snapshot the candidate's IDs/payload BEFORE recovery and all archive
        // mutations. No expected bytes ever come from recovered destinations.
        Write(dir / L"expected-new-side.json", EncodeProject(project));
        const RecoveryOracle oracle(dir);
        CHECK(ObserveChain(target) == oracle.Before());
        const TransactionFiles files(target, project.saveId);
        if (scenario.forward) {
            // Stop after the decision has been flushed on the live journal.
            save_journal_fixture::ArmDecisionBarrier(files.journal, notification.value, parked.value, deadline);
        } else {
            // Last archive move, still with the publisher's rollback decision.
            // Stopping here exposes every naturally reachable inverse move.
            ArmRenameBarrier(files.oldSide, PluginSidecar(fs::path(target.native() + L"1")),
                             notification.value, parked.value);
        }
    }, true);
    throw std::runtime_error("writer returned without its recovery fixture barrier");
}

int InterruptRecovery(const std::wstring& id) {
    const auto dir = Directory(id), target = dir / L"active.pmm";
    const auto scenario = Scenario(dir);
    const RecoveryOracle oracle(dir);
    const auto record = ReadFile(dir / L"writer-journal.json");
    const auto files = CheckJournal(dir, record, scenario.forward);
    CHECK(ReadFile(files.journal) == record && ObserveChain(target) == oracle.Pending());
    CheckStages(files, oracle, scenario, false);
    const auto boundary = RecoveryRename(target, files, scenario);
    Handle notification(OpenEventW(EVENT_MODIFY_STATE, FALSE, ReadyName(id).c_str()));
    Handle parked(CreateEventW(nullptr, TRUE, FALSE, nullptr));
    std::ofstream evidence(dir / L"recovery-interrupted.txt");
    CHECK(evidence);
    evidence << "pid=" << GetCurrentProcessId() << " decision=" << (scenario.forward ? "forward" : "rollback")
             << " boundary=" << scenario.boundary << '\n'
             << "from=" << Utf8(boundary.from.native()) << " to=" << Utf8(boundary.to.native()) << std::endl;
    ArmRenameBarrier(boundary.from, boundary.to, notification.value, parked.value);
    evidence << "attempt=1 phase=recover-begin" << std::endl;
    CHECK(evidence);
    RecoverProjectPair(target);
    evidence << "attempt=1 phase=recover-end" << std::endl;
    // Failure only: exceptions never represent a successful interruption.
    throw std::runtime_error("recovery returned without the real file-operation barrier");
}

int RetryRecovery(const std::wstring& id, unsigned freshProcess) {
    CHECK(freshProcess == 1 || freshProcess == 2);
    const auto dir = Directory(id), target = dir / L"active.pmm";
    const auto scenario = Scenario(dir);
    const RecoveryOracle oracle(dir);
    const auto record = ReadFile(dir / L"writer-journal.json");
    const auto files = CheckJournal(dir, record, scenario.forward);
    const Chain expected = scenario.forward ? oracle.Forward() : oracle.Before();
    if (freshProcess == 1) {
        CHECK(ReadFile(files.journal) == record && ObserveChain(target) == oracle.Partial(scenario));
        const fs::path marker = dir / L"cleanup-prefix.txt";
        if (fs::exists(marker)) {
            const auto prefix = ReadFile(marker);
            if (prefix == "journal-last") {
                CHECK((scenario.forward && scenario.boundary == 2) || (!scenario.forward && scenario.boundary == 6));
                CheckJournalCleanupStages(files, oracle, scenario.forward);
            } else {
                // Retry after an old EMM cleanup denial or after restoring
                // the original copy in the external replacement case.
                CHECK(prefix == "old-effect-denied" || prefix == "old-effect-restored");
                CHECK(!scenario.forward && scenario.boundary == 6);
                CheckEffectCleanupDeniedStages(files, oracle);
            }
        } else CheckStages(files, oracle, scenario, true);
    } else {
        CHECK(ObserveChain(target) == expected);
        CheckClean(files);
    }
    std::ofstream evidence(dir / (L"recovery-retry-" + std::to_wstring(freshProcess) + L".txt"));
    CHECK(evidence);
    evidence << "pid=" << GetCurrentProcessId() << " fresh_process=" << freshProcess << std::endl;
    for (unsigned attempt = 1; attempt <= 2; ++attempt) {
        evidence << "attempt=" << attempt << " phase=recover-begin" << std::endl;
        RecoverProjectPair(target);
        // Compare all bytes/absences with the pre-recovery oracle, including
        // the plugin sidecar at every generation and the vacant .pmm111.
        CHECK(ObserveChain(target) == expected);
        CHECK(ReadFile(dir / L"stage.pmm") == *oracle.fresh[0]);
        CheckClean(files);
        evidence << "attempt=" << attempt << " phase=recover-end exact_chain=1 journal=0 stages=0" << std::endl;
        CHECK(evidence);
    }
    return 0;
}

void RunRecoveryCase(bool forward, unsigned boundary) {
    CHECK(boundary >= 1 && boundary <= (forward ? 2u : 6u));
    const auto id = Wide(StorageId());
    const auto dir = Directory(id), target = dir / L"active.pmm";
    CHECK(fs::create_directory(dir));
    const std::string name = std::string(forward ? "forward-" : "rollback-") + std::to_string(boundary);
    std::cout << "SAVE-01 recovery case=" << name << " fixture=" << Utf8(dir.native()) << std::endl;
    Write(dir / L"recovery-case.txt", name);
    const auto seed = SeedRetainedPair(target, dir / L"stage.pmm");
    SaveOracle(dir / L"oracle" / L"oldest.pmm", seed.oldest);
    SaveOracle(dir / L"oracle" / L"middle.pmm", seed.middle);
    const HANDLE event = CreateEventW(nullptr, TRUE, FALSE, ReadyName(id).c_str());
    const DWORD eventError = GetLastError();
    Handle barrier(event);
    CHECK(eventError != ERROR_ALREADY_EXISTS);
    Child writer(L"--version-storage-recovery-write", id, dir);
    writer.AwaitBarrier(barrier.value);
    const RecoveryOracle oracle(dir);
    const auto scenario = Scenario(dir);
    const auto record = ReadFile(fs::path(target.native() + L".mms-save.json"));
    const auto files = CheckJournal(dir, record, forward);
    CHECK(ObserveChain(target) == oracle.Pending());
    CHECK(ReadFile(dir / L"stage.pmm") == *oracle.fresh[0]);
    CheckStages(files, oracle, scenario, false);
    Write(dir / L"writer-journal.json", record); // Evidence copy; never alter the real journal.
    writer.Interrupt();
    CHECK(writer.Join() == interrupted);
    CHECK(ObserveChain(target) == oracle.Pending() && ReadFile(files.journal) == record);
    CheckStages(files, oracle, scenario, false);

    CHECK(ResetEvent(barrier.value));
    Child recovery(L"--version-storage-recovery-interrupt", id, dir);
    recovery.AwaitBarrier(barrier.value);
    const Chain partial = oracle.Partial(scenario);
    CHECK(partial != oracle.Pending() && ObserveChain(target) == partial);
    CHECK(ReadFile(files.journal) == record); // Durable decision survives the actual recovery action.
    CheckStages(files, oracle, scenario, true);
    const auto operation = RecoveryRename(target, files, scenario);
    CHECK(!fs::exists(operation.from) && fs::exists(operation.to));
    const auto progress = ReadFile(dir / L"recovery-interrupted.txt");
    CHECK(progress.find("attempt=1 phase=recover-begin") != std::string::npos);
    CHECK(progress.find("phase=recover-end") == std::string::npos);
    std::cout << "verified paused recovery case=" << name << " real move=" << Utf8(operation.from.native())
              << " -> " << Utf8(operation.to.native()) << " journal=1 recover-end=0" << std::endl;
    recovery.Interrupt();
    CHECK(recovery.Join() == interrupted);
    CHECK(ObserveChain(target) == partial && ReadFile(files.journal) == record);
    CheckStages(files, oracle, scenario, true);
    std::cout << progress << std::flush;

    const Chain expected = forward ? oracle.Forward() : oracle.Before();
    Chain first{};
    for (unsigned attempt = 1; attempt <= 2; ++attempt) {
        Child retry(attempt == 1 ? L"--version-storage-recovery-first" : L"--version-storage-recovery-second", id, dir);
        const auto code = retry.Join();
        const auto report = dir / (L"recovery-retry-" + std::to_wstring(attempt) + L".txt");
        if (fs::exists(report)) std::cout << ReadFile(report) << std::flush;
        CHECK(code == 0);
        const auto observed = ObserveChain(target);
        CHECK(observed == expected && ReadFile(dir / L"stage.pmm") == *oracle.fresh[0]);
        CheckClean(files);
        if (attempt == 1) first = observed;
        else CHECK(observed == first);
    }
    std::cout << "PASS SAVE-01 recovery case=" << name << " hard-kills=2 fresh-retries=2" << std::endl;
}

// A real sharing denial, not an injected failure or a fabricated journal:
// hold one owned member open without FILE_SHARE_DELETE, run the real recovery
// in this process, and require its exact Win32 failure. The same durable
// decision is then finished by two independent fresh processes.
void RunDeniedRecoveryCase(bool forward, bool cleanup) {
    const auto id = Wide(StorageId());
    const auto dir = Directory(id), target = dir / L"active.pmm", stage = dir / L"stage.pmm";
    CHECK(fs::create_directory(dir)); // Never reuse a previous run.
    const unsigned boundary = forward ? (cleanup ? 2u : 1u) : (cleanup ? 6u : 4u);
    const std::string name = std::string(forward ? "forward-" : "rollback-") + std::to_string(boundary);
    const char* point = cleanup ? "complete-recovery-record"
                                : (forward ? "publish-new-sidecar" : "restore-oldest-emm");
    std::cout << "SAVE-01 sharing-denied case=" << name << " fixture=" << Utf8(dir.native()) << std::endl;
    Write(dir / L"recovery-case.txt", name);
    // Journal-last cleanup prefix: only the denied cleanup cases own this
    // exact expected snapshot for the fresh retry child's initial observation.
    if (cleanup) Write(dir / L"cleanup-prefix.txt", "journal-last");
    const auto seed = SeedRetainedPair(target, stage);
    SaveOracle(dir / L"oracle" / L"oldest.pmm", seed.oldest);
    SaveOracle(dir / L"oracle" / L"middle.pmm", seed.middle);
    const HANDLE event = CreateEventW(nullptr, TRUE, FALSE, ReadyName(id).c_str());
    const DWORD eventError = GetLastError();
    Handle barrier(event);
    CHECK(eventError != ERROR_ALREADY_EXISTS);
    Child writer(L"--version-storage-recovery-write", id, dir);
    writer.AwaitBarrier(barrier.value);
    const RecoveryOracle oracle(dir);
    const auto scenario = Scenario(dir);
    CHECK(scenario.forward == forward && scenario.boundary == boundary);
    const auto record = ReadFile(fs::path(target.native() + L".mms-save.json"));
    const auto files = CheckJournal(dir, record, forward);
    CHECK(ObserveChain(target) == oracle.Pending());
    CHECK(ReadFile(stage) == *oracle.fresh[0]);
    CheckStages(files, oracle, scenario, false);
    Write(dir / L"writer-journal.json", record); // Evidence copy; never alter the real journal.
    writer.Interrupt();
    CHECK(writer.Join() == interrupted);
    CHECK(ObserveChain(target) == oracle.Pending() && ReadFile(files.journal) == record);
    CheckStages(files, oracle, scenario, false);

    const auto expected = oracle.Partial(scenario);
    const std::string denied = cleanup ? "complete recovery record (Win32 32)" :
        (forward ? "publish project file (Win32 32)" : "open retained member for rename (Win32 32)");
    const fs::path oldestEmm = VersionMembers(fs::path(target.native() + L"11"))[1];
    const fs::path lockPath = cleanup ? files.journal : (forward ? files.newSide : oldestEmm);
    CHECK(fs::exists(lockPath));
    std::ofstream evidence(dir / L"recovery-denied.txt");
    CHECK(evidence);
    evidence << "pid=" << GetCurrentProcessId() << " decision=" << (forward ? "forward" : "rollback")
             << " boundary=" << boundary << " point=" << point
             << " lock=" << Utf8(lockPath.native()) << std::endl;
    Chain first{};
    {
        // READ sharing only: bytes, attributes, and ACL stay untouched.
        Handle held(CreateFileW(lockPath.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
                                nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr));
        for (unsigned attempt = 1; attempt <= 2; ++attempt) {
            bool failed = false;
            std::string observed;
            try {
                RecoverProjectPair(target);
            } catch (const std::exception& ex) {
                observed = ex.what();
                failed = true;
            }
            CHECK(failed);             // A returning recovery is not a pass.
            CHECK(observed == denied); // Never accept a different failure.
            const auto chain = ObserveChain(target);
            CHECK(chain == expected);  // Independent bytes/absences, not attempt one.
            CHECK(ReadFile(files.journal) == record);
            CHECK(ReadFile(stage) == *oracle.fresh[0]);
            if (cleanup) CheckJournalCleanupStages(files, oracle, forward);
            else CheckStages(files, oracle, scenario, true);
            const HANDLE probe = CreateFileW(lockPath.c_str(), DELETE, 0, nullptr, OPEN_EXISTING,
                                             FILE_ATTRIBUTE_NORMAL, nullptr);
            const DWORD native = GetLastError();
            if (probe != INVALID_HANDLE_VALUE) CloseHandle(probe);
            CHECK(probe == INVALID_HANDLE_VALUE && native == ERROR_SHARING_VIOLATION);
            if (attempt == 1) first = chain;
            else CHECK(chain == first);
            evidence << "attempt=" << attempt << " pid=" << GetCurrentProcessId()
                     << " decision=" << (forward ? "forward" : "rollback") << " boundary=" << boundary
                     << " point=" << point << " lock=" << Utf8(lockPath.native())
                     << " native=" << native << " error=\"" << observed << "\""
                     << " chain_exact=1 journal_unchanged=1 stage_unchanged=1 stages_exact=1" << std::endl;
            CHECK(evidence);
        }
    }
    // The held handle is closed; only independent processes may finish now.
    const Chain finished = forward ? oracle.Forward() : oracle.Before();
    Chain retried{};
    for (unsigned attempt = 1; attempt <= 2; ++attempt) {
        Child retry(attempt == 1 ? L"--version-storage-recovery-first" : L"--version-storage-recovery-second", id, dir);
        const auto code = retry.Join();
        const auto report = dir / (L"recovery-retry-" + std::to_wstring(attempt) + L".txt");
        if (fs::exists(report)) std::cout << ReadFile(report) << std::flush;
        CHECK(code == 0);
        const auto observed = ObserveChain(target);
        CHECK(observed == finished && ReadFile(stage) == *oracle.fresh[0]);
        CheckClean(files);
        if (attempt == 1) retried = observed;
        else CHECK(observed == retried);
    }
    evidence.flush();
    CHECK(evidence);
    std::cout << ReadFile(dir / L"recovery-denied.txt") << std::flush;
    std::cout << "PASS SAVE-01 sharing-denied recovery case=" << name
              << " denied-attempts=2 fresh-retries=2 lock=" << Utf8(lockPath.native()) << std::endl;
}

// A real read-only attribute on the first cleanup member, not an injected
// failure or a fabricated journal: recovery must report the checked stage
// removal, keep the durable journal until every stage is removed, and leave
// the owned fixture for two independent fresh processes to finish.
struct RestoreAttributes {
    fs::path path;
    DWORD saved;
    bool pending;
    RestoreAttributes(const fs::path& value, DWORD attributes)
        : path(value), saved(attributes), pending(true) {}
    RestoreAttributes(const RestoreAttributes&) = delete;
    RestoreAttributes& operator=(const RestoreAttributes&) = delete;
    ~RestoreAttributes() {
        if (pending) SetFileAttributesW(path.c_str(), saved);
    }
    void Restore() {
        CHECK(pending);
        CHECK(SetFileAttributesW(path.c_str(), saved) != FALSE);
        pending = false;
    }
};
void RunReadOnlyCleanupRecoveryCase() {
    const auto id = Wide(StorageId());
    const auto dir = Directory(id), target = dir / L"active.pmm", stage = dir / L"stage.pmm";
    CHECK(fs::create_directory(dir)); // Never reuse a previous run.
    const std::string name = "rollback-6";
    std::cout << "SAVE-01 readonly-cleanup case=" << name << " fixture=" << Utf8(dir.native()) << std::endl;
    Write(dir / L"recovery-case.txt", name);
    const auto seed = SeedRetainedPair(target, stage);
    SaveOracle(dir / L"oracle" / L"oldest.pmm", seed.oldest);
    SaveOracle(dir / L"oracle" / L"middle.pmm", seed.middle);
    const HANDLE event = CreateEventW(nullptr, TRUE, FALSE, ReadyName(id).c_str());
    const DWORD eventError = GetLastError();
    Handle barrier(event);
    CHECK(eventError != ERROR_ALREADY_EXISTS);
    Child writer(L"--version-storage-recovery-write", id, dir);
    writer.AwaitBarrier(barrier.value);
    const RecoveryOracle oracle(dir);
    const auto scenario = Scenario(dir);
    CHECK(!scenario.forward && scenario.boundary == 6);
    const auto record = ReadFile(fs::path(target.native() + L".mms-save.json"));
    const auto files = CheckJournal(dir, record, false);
    CHECK(ObserveChain(target) == oracle.Pending());
    CHECK(ReadFile(stage) == *oracle.fresh[0]);
    CheckStages(files, oracle, scenario, false);
    Write(dir / L"writer-journal.json", record); // Evidence copy; never alter the real journal.
    writer.Interrupt();
    CHECK(writer.Join() == interrupted);
    CHECK(ObserveChain(target) == oracle.Pending() && ReadFile(files.journal) == record);
    CheckStages(files, oracle, scenario, false);

    // newMain is the first cleanup member. The real attribute, not an
    // injected error, must make recovery fail before the durable journal is
    // removed and before any other owned stage is discarded.
    CHECK(fs::is_regular_file(files.newMain));
    const DWORD original = GetFileAttributesW(files.newMain.c_str());
    CHECK(original != INVALID_FILE_ATTRIBUTES);
    CHECK((original & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) == 0);
    CHECK((original & FILE_ATTRIBUTE_READONLY) == 0);
    CHECK(ReadFile(files.newMain) == *oracle.fresh[0]);
    RestoreAttributes restore(files.newMain, original);
    CHECK(SetFileAttributesW(files.newMain.c_str(), original | FILE_ATTRIBUTE_READONLY) != FALSE);
    // Calibration: the real API performs the denial, no MinHook involved.
    const BOOL calibrationOk = DeleteFileW(files.newMain.c_str());
    const DWORD calibration = GetLastError();
    CHECK(calibrationOk == FALSE && calibration == ERROR_ACCESS_DENIED);
    CHECK(fs::is_regular_file(files.newMain) && ReadFile(files.newMain) == *oracle.fresh[0]);

    std::ofstream evidence(dir / L"recovery-readonly.txt");
    CHECK(evidence);
    evidence << "pid=" << GetCurrentProcessId() << " case=" << name
             << " member=" << Utf8(files.newMain.native())
             << " calibration=" << calibration << std::endl;
    Chain first{};
    for (unsigned attempt = 1; attempt <= 2; ++attempt) {
        bool failed = false;
        std::string observed;
        try { RecoverProjectPair(target); }
        catch (const std::exception& ex) { observed = ex.what(); failed = true; }
        const auto chain = ObserveChain(target);
        const bool journal = fs::exists(files.journal);
        const bool staged = fs::exists(files.newMain);
        const bool before = chain == oracle.Before();
        // RED evidence precedes every failure check: a silent return must
        // expose the lost journal and the surviving read-only stage.
        evidence << "attempt=" << attempt << " pid=" << GetCurrentProcessId()
                 << " case=" << name << " calibration=" << calibration
                 << " failed=" << failed << " error=\"" << observed << "\""
                 << " journal_present=" << journal << " new_main_present=" << staged
                 << " chain_before=" << before << std::endl;
        evidence.flush();
        CHECK(evidence);
        std::cout << "SAVE-01 readonly-cleanup attempt=" << attempt << " failed=" << failed
                  << " error=\"" << observed << "\" journal_present=" << journal
                  << " new_main_present=" << staged << " chain_before=" << before << std::endl;
        CHECK(failed); // A returning recovery is not a pass.
        CHECK(observed == "remove recovery stage (Win32 5)"); // Never accept another failure.
        CHECK(before); // Independent bytes/absences, not an earlier recovery.
        CHECK(ReadFile(files.journal) == record);
        CHECK(ReadFile(stage) == *oracle.fresh[0]);
        CheckStages(files, oracle, scenario, true);
        const DWORD attributes = GetFileAttributesW(files.newMain.c_str());
        CHECK(attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_READONLY));
        const BOOL nativeOk = DeleteFileW(files.newMain.c_str());
        const DWORD native = GetLastError();
        CHECK(nativeOk == FALSE && native == ERROR_ACCESS_DENIED);
        CHECK(ReadFile(files.newMain) == *oracle.fresh[0]);
        if (attempt == 1) first = chain;
        else CHECK(chain == first);
        evidence << "attempt=" << attempt << " native=" << native
                 << " chain_exact=1 journal_unchanged=1 stage_unchanged=1 stages_exact=1 readonly=1"
                 << std::endl;
        CHECK(evidence);
    }
    // Attributes are restored before any independent process may finish the
    // same durable decision; the owned fixture and evidence are kept.
    restore.Restore();
    const DWORD restored = GetFileAttributesW(files.newMain.c_str());
    CHECK(restored != INVALID_FILE_ATTRIBUTES && restored == original);
    CHECK(fs::is_regular_file(files.newMain) && ReadFile(files.newMain) == *oracle.fresh[0]);

    const Chain finished = oracle.Before();
    Chain retried{};
    for (unsigned attempt = 1; attempt <= 2; ++attempt) {
        Child retry(attempt == 1 ? L"--version-storage-recovery-first" : L"--version-storage-recovery-second", id, dir);
        const auto code = retry.Join();
        const auto report = dir / (L"recovery-retry-" + std::to_wstring(attempt) + L".txt");
        if (fs::exists(report)) std::cout << ReadFile(report) << std::flush;
        CHECK(code == 0);
        const auto observed = ObserveChain(target);
        CHECK(observed == finished && ReadFile(stage) == *oracle.fresh[0]);
        CheckClean(files);
        if (attempt == 1) retried = observed;
        else CHECK(observed == retried);
    }
    evidence.flush();
    CHECK(evidence);
    std::cout << ReadFile(dir / L"recovery-readonly.txt") << std::flush;
    std::cout << "PASS SAVE-01 readonly-cleanup recovery case=" << name
              << " denied-attempts=2 fresh-retries=2 member=" << Utf8(files.newMain.native()) << std::endl;
}

// The read-only variant inherits a real attribute from the owned fixture; it
// is not an injected failure. Both public levels are captured before the
// writer starts and must be byte- and attribute-exact after the independent
// processes finish the same durable decision.
struct PublicFixture {
    fs::path project;
    Level bytes;
    std::array<DWORD, 3> attributes{};
    explicit PublicFixture(const fs::path& value) : project(value) {
        const auto members = VersionMembers(project);
        CHECK(members.size() == attributes.size());
        for (size_t i = 0; i < members.size(); ++i) {
            CHECK(fs::is_regular_file(members[i]));
            attributes[i] = GetFileAttributesW(members[i].c_str());
            CHECK(attributes[i] != INVALID_FILE_ATTRIBUTES);
            bytes[i] = ReadFile(members[i]);
        }
    }
};
void CheckPublicFixture(const PublicFixture& expected) {
    const auto members = VersionMembers(expected.project);
    for (size_t i = 0; i < members.size(); ++i) {
        CHECK(fs::is_regular_file(members[i]));
        CHECK(GetFileAttributesW(members[i].c_str()) == expected.attributes[i]);
        CHECK(expected.bytes[i].has_value() && ReadFile(members[i]) == *expected.bytes[i]);
    }
}

// Parent-process observation of the exact staged old EMM during the real
// recovery. No failure is injected: the original API is forwarded exactly
// once, its last error is preserved, and only this fixture path is recorded,
// only from the parent test thread and only while the parent itself calls
// RecoverProjectPair.
struct EffectDeleteObservation {
    fs::path path;
    DWORD thread = 0;
    bool recording = false;
    unsigned matches = 0;
    DWORD attributesBefore = INVALID_FILE_ATTRIBUTES;
    BY_HANDLE_FILE_INFORMATION identity{};
    BOOL result = FALSE;
    DWORD error = 0;
    explicit EffectDeleteObservation(const fs::path& value) : path(value) {}
    void Begin() {
        matches = 0;
        attributesBefore = INVALID_FILE_ATTRIBUTES;
        result = FALSE;
        error = 0;
        recording = true;
    }
    void End() { recording = false; }
};
// One pointer per thread: other threads see their own null pointer and only
// forward the original API, so they never read the parent's mutable record.
static thread_local EffectDeleteObservation* effectDeleteObservation = nullptr;
static decltype(&SetFileInformationByHandle) originalDelete;
static BOOL WINAPI ObserveEffectDelete(HANDLE file, FILE_INFO_BY_HANDLE_CLASS type, LPVOID data, DWORD size) {
    EffectDeleteObservation* observation = effectDeleteObservation;
    const DWORD incoming = GetLastError();
    BY_HANDLE_FILE_INFORMATION actual{};
    const bool match = observation && observation->recording &&
        GetCurrentThreadId() == observation->thread && type == FileDispositionInfo &&
        data && size == sizeof(FILE_DISPOSITION_INFO) && static_cast<const FILE_DISPOSITION_INFO*>(data)->DeleteFile &&
        GetFileInformationByHandle(file, &actual) && actual.dwVolumeSerialNumber == observation->identity.dwVolumeSerialNumber &&
        actual.nFileIndexHigh == observation->identity.nFileIndexHigh && actual.nFileIndexLow == observation->identity.nFileIndexLow;
    if (match) {
        ++observation->matches;
        observation->attributesBefore = actual.dwFileAttributes;
    }
    // GetFileAttributesW may change the last error; restore the caller's
    // original value before forwarding the one real API call.
    SetLastError(incoming);
    const BOOL ok = originalDelete(file, type, data, size);
    const DWORD error = GetLastError();
    if (match) {
        observation->result = ok;
        observation->error = error;
    }
    SetLastError(error);
    return ok;
}
class EffectDeleteHook {
    bool initialized = false, created = false, enabled = false;
    void Close() {
        effectDeleteObservation = nullptr;
        if (enabled) { MH_DisableHook(reinterpret_cast<void*>(&SetFileInformationByHandle)); enabled = false; }
        if (created) { MH_RemoveHook(reinterpret_cast<void*>(&SetFileInformationByHandle)); created = false; }
        if (initialized) { MH_Uninitialize(); initialized = false; }
    }
public:
    explicit EffectDeleteHook(EffectDeleteObservation& observation) {
        {
            Handle file(CreateFileW(observation.path.c_str(), FILE_READ_ATTRIBUTES,
                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, 0, nullptr));
            CHECK(GetFileInformationByHandle(file.value, &observation.identity));
        }
        effectDeleteObservation = &observation;
        observation.thread = GetCurrentThreadId();
        try {
            const auto initializedResult = MH_Initialize();
            initialized = initializedResult == MH_OK;
            CHECK(initialized || initializedResult == MH_ERROR_ALREADY_INITIALIZED);
            CHECK(MH_CreateHook(reinterpret_cast<void*>(&SetFileInformationByHandle),
                                reinterpret_cast<void*>(&ObserveEffectDelete),
                                reinterpret_cast<void**>(&originalDelete)) == MH_OK);
            created = true;
            // Enable only this exact API; never MH_ALL_HOOKS.
            CHECK(MH_EnableHook(reinterpret_cast<void*>(&SetFileInformationByHandle)) == MH_OK);
            enabled = true;
        } catch (...) {
            Close();
            throw;
        }
    }
    ~EffectDeleteHook() { Close(); }
    EffectDeleteHook(const EffectDeleteHook&) = delete;
    EffectDeleteHook& operator=(const EffectDeleteHook&) = delete;
};
// A real sharing denial of the recovered old EMM stage, not an injected
// failure: the stage exists only after the inverse archive moves, so run the
// real recovery to that boundary first, then hold its restored oldEffect
