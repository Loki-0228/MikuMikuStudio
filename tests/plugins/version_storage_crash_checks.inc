    const auto operation = RecoveryRename(target, files, scenario);
    CHECK(!fs::exists(operation.from) && fs::exists(operation.to));
    const auto progress = ReadFile(dir / L"recovery-interrupted.txt");
    CHECK(progress.find("attempt=1 phase=recover-begin") != std::string::npos);
    CHECK(progress.find("phase=recover-end") == std::string::npos);
    recovery.Interrupt();
    CHECK(recovery.Join() == interrupted);
    CHECK(ObserveChain(target) == oracle.Before() && ReadFile(files.journal) == record);
    CHECK(ReadFile(stage) == *oracle.fresh[0]);
    CheckStages(files, oracle, scenario, true);

    CHECK(fs::is_regular_file(files.oldEffect));
    const DWORD originalAttributes = GetFileAttributesW(files.oldEffect.c_str());
    CHECK(originalAttributes != INVALID_FILE_ATTRIBUTES);
    CHECK((originalAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) == 0);
    CHECK(ReadFile(files.oldEffect) == *oracle.middle[1]);
    if (readonly) {
        // The rolled-back stage is the transaction's CopyDurable copy of the
        // fixture's active EMM. It must inherit READONLY and the independent
        // middle bytes before any calibration or hold touches it.
        const bool inherited = (originalAttributes & FILE_ATTRIBUTE_READONLY) != 0;
        const bool bytes = ReadFile(files.oldEffect) == *oracle.middle[1];
        {
            std::ofstream fixtureEvidence(dir / L"recovery-readonly-fixture.txt", std::ios::app);
            CHECK(fixtureEvidence);
            fixtureEvidence << "inherited_effect=" << Utf8(files.oldEffect.native())
                            << " attributes=" << originalAttributes
                            << " readonly=" << inherited << " middle_bytes=" << bytes << std::endl;
            fixtureEvidence.flush();
            CHECK(fixtureEvidence);
        }
        CHECK(inherited);
        CHECK(bytes);
    }
    std::ofstream evidence(dir / (readonly ? L"recovery-readonly-effect-cleanup.txt"
                                           : L"recovery-effect-cleanup-denied.txt"));
    CHECK(evidence);
    evidence << "pid=" << GetCurrentProcessId() << " case=" << name
             << " effect=" << Utf8(files.oldEffect.native())
             << " attributes=" << originalAttributes;
    if (readonly) evidence << " variant=readonly";
    evidence << std::endl;
    Chain first{};
    {
        // The observation hook lives only for the two parent-thread attempts
        // inside this hold, never for the independent processes below.
        EffectDeleteObservation observedDelete(files.oldEffect);
        std::optional<EffectDeleteHook> deleteHook;
        if (readonly) {
            // Calibrate the real READONLY denial without any sharing hold: the
            // API itself refuses, and bytes and attributes stay unchanged.
            const BOOL removed = DeleteFileW(files.oldEffect.c_str());
            const DWORD denied = GetLastError();
            CHECK(removed == FALSE && denied == ERROR_ACCESS_DENIED);
            CHECK(fs::is_regular_file(files.oldEffect));
            CHECK(ReadFile(files.oldEffect) == *oracle.middle[1]);
            CHECK(GetFileAttributesW(files.oldEffect.c_str()) == originalAttributes);
            std::ofstream fixtureEvidence(dir / L"recovery-readonly-fixture.txt", std::ios::app);
            CHECK(fixtureEvidence);
            fixtureEvidence << "calibration_readonly_delete=" << denied
                            << " unchanged=1" << std::endl;
            fixtureEvidence.flush();
            CHECK(fixtureEvidence);
        }
        // READ sharing only: no FILE_SHARE_DELETE, so the real API refuses.
        Handle held(CreateFileW(files.oldEffect.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
                                nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr));
        DWORD calibration = 0;
        if (readonly) {
            // Calibrate the real sharing denial with DELETE access only. No
            // delete flag is set and nothing is removed.
            const HANDLE probe = CreateFileW(files.oldEffect.c_str(), DELETE, 0, nullptr, OPEN_EXISTING,
                                             FILE_ATTRIBUTE_NORMAL, nullptr);
            const DWORD shareDenied = GetLastError();
            if (probe != INVALID_HANDLE_VALUE) CloseHandle(probe);
            CHECK(probe == INVALID_HANDLE_VALUE && shareDenied == ERROR_SHARING_VIOLATION);
            CHECK(fs::is_regular_file(files.oldEffect));
            CHECK(ReadFile(files.oldEffect) == *oracle.middle[1]);
            CHECK(GetFileAttributesW(files.oldEffect.c_str()) == originalAttributes);
            calibration = shareDenied;
            std::ofstream fixtureEvidence(dir / L"recovery-readonly-fixture.txt", std::ios::app);
            CHECK(fixtureEvidence);
            fixtureEvidence << "calibration_sharing_delete=" << shareDenied << std::endl;
            fixtureEvidence.flush();
            CHECK(fixtureEvidence);
            // Record exactly this API, from this thread, while the parent runs
            // the real recovery below. No failure is injected.
            deleteHook.emplace(observedDelete);
        } else {
            const BOOL calibrationOk = DeleteFileW(files.oldEffect.c_str());
            calibration = GetLastError();
            CHECK(calibrationOk == FALSE && calibration == ERROR_SHARING_VIOLATION);
            CHECK(fs::is_regular_file(files.oldEffect));
            CHECK(ReadFile(files.oldEffect) == *oracle.middle[1]);
            CHECK(GetFileAttributesW(files.oldEffect.c_str()) == originalAttributes);
        }
        for (unsigned attempt = 1; attempt <= 2; ++attempt) {
            bool failed = false;
            std::string observed;
            if (readonly) observedDelete.Begin();
            try { RecoverProjectPair(target); }
            catch (const std::exception& ex) { observed = ex.what(); failed = true; }
            observedDelete.End();
            const auto chain = ObserveChain(target);
            const bool journal = fs::exists(files.journal);
            const bool effect = fs::exists(files.oldEffect);
            const bool before = chain == oracle.Before();
            // RED evidence precedes every failure check: the current
            // production silently drops the journal and keeps the stage.
            evidence << "attempt=" << attempt << " pid=" << GetCurrentProcessId()
                     << " case=" << name << " calibration=" << calibration
                     << " failed=" << failed << " error=\"" << observed << "\""
                     << " journal_present=" << journal << " old_effect_present=" << effect
                     << " chain_before=" << before << std::endl;
            evidence.flush();
            CHECK(evidence);
            std::cout << "SAVE-01 " << (readonly ? "readonly-effect-cleanup" : "effect-cleanup-denied")
                      << " attempt=" << attempt
                      << " failed=" << failed << " error=\"" << observed << "\""
                      << " journal_present=" << journal << " old_effect_present=" << effect
                      << " chain_before=" << before << std::endl;
            if (readonly) {
                // Exact evidence of the real API call before any assertion.
                evidence << "attempt=" << attempt << " matched_delete=" << observedDelete.matches
                         << " attributes_before=" << observedDelete.attributesBefore
                         << " delete_result=" << int(observedDelete.result)
                         << " delete_error=" << observedDelete.error
                         << " readonly_cleared="
                         << ((observedDelete.attributesBefore & FILE_ATTRIBUTE_READONLY) == 0)
                         << " attributes_restored="
                         << (GetFileAttributesW(files.oldEffect.c_str()) == originalAttributes)
                         << std::endl;
                evidence.flush();
                CHECK(evidence);
            }
            CHECK(failed); // A returning recovery is not a pass.
            CHECK(observed == "remove recovery stage (Win32 32)"); // Never accept another failure.
            CHECK(before); // Independent bytes/absences, not an earlier recovery.
            CHECK(ReadFile(files.journal) == record); // The checked journal is deleted last.
            CHECK(ReadFile(stage) == *oracle.fresh[0]);
            CHECK(ReadFile(files.oldEffect) == *oracle.middle[1]);
            CHECK(GetFileAttributesW(files.oldEffect.c_str()) == originalAttributes);
            CheckEffectCleanupDeniedStages(files, oracle);
            if (readonly) {
                // Sharing denial prevents obtaining the cleanup handle, so
                // the read-only stage never reaches disposition.
                CHECK(observedDelete.matches == 0);
                CHECK((GetFileAttributesW(files.oldEffect.c_str()) & FILE_ATTRIBUTE_READONLY) != 0);
            }
            DWORD native = 0;
            if (readonly) {
                // The non-destructive DELETE-access open independently
                // confirms the sharing denial on the same read-only stage.
                const HANDLE probe = CreateFileW(files.oldEffect.c_str(), DELETE, 0, nullptr, OPEN_EXISTING,
                                                 FILE_ATTRIBUTE_NORMAL, nullptr);
                native = GetLastError();
                if (probe != INVALID_HANDLE_VALUE) CloseHandle(probe);
                CHECK(probe == INVALID_HANDLE_VALUE && native == ERROR_SHARING_VIOLATION);
            } else {
                const BOOL nativeOk = DeleteFileW(files.oldEffect.c_str());
                native = GetLastError();
                CHECK(nativeOk == FALSE && native == ERROR_SHARING_VIOLATION);
            }
            CHECK(ReadFile(files.oldEffect) == *oracle.middle[1]);
            if (attempt == 1) first = chain;
            else CHECK(chain == first);
            evidence << "attempt=" << attempt << " native=" << native
                     << " chain_exact=1 journal_unchanged=1 old_effect_unchanged=1 cleanup_prefix=1"
                     << std::endl;
            CHECK(evidence);
            if (readonly) {
                // The public pair stays exact after every failed attempt.
                CheckPublicFixture(*fixtureActive);
                CheckPublicFixture(*fixtureGen1);
                evidence << "attempt=" << attempt
                         << " public_active_exact=1 public_gen1_exact=1" << std::endl;
                CHECK(evidence);
            }
        }
        // Stop observing before the hold is released and before any retry.
        deleteHook.reset();
    }
    // The held handle is closed; only independent processes may finish now.
    // The owned fixture and every evidence file stay on disk.
    CHECK(fs::is_regular_file(files.oldEffect));
    CHECK(ReadFile(files.oldEffect) == *oracle.middle[1]);
    CHECK(GetFileAttributesW(files.oldEffect.c_str()) == originalAttributes);
    if (readonly) {
        // The test never clears the attribute: the stage is still the real
        // READONLY copy, and the independent processes own the cleanup.
        const DWORD retained = GetFileAttributesW(files.oldEffect.c_str());
        CHECK((retained & FILE_ATTRIBUTE_READONLY) != 0);
        evidence << "released_hold_pid=" << GetCurrentProcessId()
                 << " attributes=" << retained << " readonly=1 stage=1" << std::endl;
        CHECK(evidence);
    }
    const Chain finished = oracle.Before();
    Chain retried{};
    std::string firstRetryPid, secondRetryPid;
    for (unsigned attempt = 1; attempt <= 2; ++attempt) {
        Child retry(attempt == 1 ? L"--version-storage-recovery-first" : L"--version-storage-recovery-second", id, dir);
        const auto code = retry.Join();
        const auto report = dir / (L"recovery-retry-" + std::to_wstring(attempt) + L".txt");
        if (fs::exists(report)) std::cout << ReadFile(report) << std::flush;
        CHECK(code == 0);
        CHECK(fs::exists(report));
        const auto reported = ReadFile(report);
        CHECK(reported.find("pid=") != std::string::npos);
        CHECK(reported.find("fresh_process=" + std::to_string(attempt)) != std::string::npos);
        CHECK(reported.find("attempt=2 phase=recover-end exact_chain=1 journal=0 stages=0") != std::string::npos);
        if (readonly) {
            // Two independent processes must have finished the durable
            // decision; the test itself never clears the attribute.
            const auto at = reported.find("pid=");
            CHECK(at != std::string::npos);
            const auto end = reported.find_first_of(" \r\n", at + 4);
            const auto pid = reported.substr(at + 4, end == std::string::npos ? std::string::npos : end - at - 4);
            CHECK(pid != std::to_string(GetCurrentProcessId()));
            if (attempt == 1) firstRetryPid = pid;
            else {
                secondRetryPid = pid;
                CHECK(secondRetryPid != firstRetryPid);
            }
            evidence << "fresh_process=" << attempt << " pid=" << pid
                     << " report_exact=1 journal=0 stages=0" << std::endl;
            CHECK(evidence);
        }
        const auto observed = ObserveChain(target);
        CHECK(observed == finished && ReadFile(stage) == *oracle.fresh[0]);
        CheckClean(files);
        if (readonly) {
            // Every independent process leaves the public pair byte- and
            // attribute-exact, not only the final fixture check below.
            CheckPublicFixture(*fixtureActive);
            CheckPublicFixture(*fixtureGen1);
            evidence << "fresh_process=" << attempt
                     << " public_active_exact=1 public_gen1_exact=1" << std::endl;
            CHECK(evidence);
        }
        if (attempt == 1) retried = observed;
        else CHECK(observed == retried);
    }
    if (readonly) {
        // Production, not the test, cleared the real READONLY transaction copy
        // and removed every transaction member. Public bytes and attributes
        // remain exactly the fixture's.
        CheckPublicFixture(*fixtureActive);
        CheckPublicFixture(*fixtureGen1);
        CHECK(!fs::exists(target.native() + L"11"));
        CHECK(!fs::exists(target.native() + L"111"));
        evidence << "final_pid=" << GetCurrentProcessId()
                 << " fresh_pids=" << firstRetryPid << ',' << secondRetryPid
                 << " public_active_exact=1 public_gen1_exact=1"
                 << " level11=0 level111=0 stages=0 journal=0" << std::endl;
        CHECK(evidence);
    }
    evidence.flush();
    CHECK(evidence);
    std::cout << ReadFile(dir / (readonly ? L"recovery-readonly-effect-cleanup.txt"
                                           : L"recovery-effect-cleanup-denied.txt")) << std::flush;
    std::cout << "PASS SAVE-01 " << (readonly ? "readonly-effect-cleanup" : "effect-cleanup-denied")
              << " recovery case=" << name
              << " denied-attempts=2 fresh-retries=2 effect=" << Utf8(files.oldEffect.native());
    if (readonly) std::cout << " inherited-readonly=1 fresh-pids=" << firstRetryPid << ',' << secondRetryPid;
    std::cout << std::endl;
}
void RunReplacedEffectCleanupRecoveryCase() {
    const auto id = Wide(StorageId());
    const auto dir = Directory(id), target = dir / L"active.pmm", stage = dir / L"stage.pmm";
    CHECK(fs::create_directory(dir));
    std::cout << "SAVE-01 external old-effect replacement fixture=" << Utf8(dir.native()) << std::endl;
    Write(dir / L"recovery-case.txt", "rollback-6");
    const auto seed = SeedRetainedPair(target, stage);
    SaveOracle(dir / L"oracle" / L"oldest.pmm", seed.oldest);
    SaveOracle(dir / L"oracle" / L"middle.pmm", seed.middle);
    const PublicFixture active(target), retained(fs::path(target.native() + L"1"));

    const HANDLE event = CreateEventW(nullptr, TRUE, FALSE, ReadyName(id).c_str());
    const DWORD eventError = GetLastError();
    Handle barrier(event);
    CHECK(eventError != ERROR_ALREADY_EXISTS);
    Child writer(L"--version-storage-recovery-write", id, dir);
    writer.AwaitBarrier(barrier.value);
    const RecoveryOracle oracle(dir);
    const auto scenario = Scenario(dir);
    const auto record = ReadFile(fs::path(target.native() + L".mms-save.json"));
    const auto files = CheckJournal(dir, record, false);
    Write(dir / L"writer-journal.json", record);
    writer.Interrupt();
    CHECK(writer.Join() == interrupted);
    CHECK(ReadFile(files.journal) == record && ObserveChain(target) == oracle.Pending());
    CheckStages(files, oracle, scenario, false);

    // The last inverse rename restores the public chain and leaves oldEffect
    // available at its private stage path before cleanup runs.
    CHECK(ResetEvent(barrier.value));
    Child recovery(L"--version-storage-recovery-interrupt", id, dir);
    recovery.AwaitBarrier(barrier.value);
    recovery.Interrupt();
    CHECK(recovery.Join() == interrupted);
    CHECK(ReadFile(files.journal) == record);
    CheckStages(files, oracle, scenario, true);
    const auto checkPublic = [&] {
        CHECK(ObserveChain(target) == oracle.Before());
        CheckPublicFixture(active);
        CheckPublicFixture(retained);
        CHECK(ReadFile(stage) == *oracle.fresh[0]);
    };
    checkPublic();

    const auto original = dir / L"preserved-old-effect.emm";
    const auto external = dir / L"preserved-external-effect.emm";
    const auto checkEffect = [](const fs::path& path, const std::string& bytes, DWORD attributes) {
        CHECK(fs::is_regular_file(path) && ReadFile(path) == bytes);
        CHECK(GetFileAttributesW(path.c_str()) == attributes);
    };
    const DWORD originalAttributes = GetFileAttributesW(files.oldEffect.c_str());
    CHECK(originalAttributes != INVALID_FILE_ATTRIBUTES);
    CHECK(MoveFileExW(files.oldEffect.c_str(), original.c_str(), MOVEFILE_WRITE_THROUGH));
    checkEffect(original, *oracle.middle[1], originalAttributes);
    auto replacement = *oracle.middle[1];
    replacement[0] = 'X'; // Same size, different generation hash.
    Write(files.oldEffect, replacement);
    CHECK(FileHash(files.oldEffect) != FileHash(original));
    const DWORD writableAttributes = GetFileAttributesW(files.oldEffect.c_str());
    CHECK(writableAttributes != INVALID_FILE_ATTRIBUTES && !(writableAttributes & FILE_ATTRIBUTE_READONLY));
    CHECK(SetFileAttributesW(files.oldEffect.c_str(), writableAttributes | FILE_ATTRIBUTE_READONLY));
    const DWORD replacementAttributes = GetFileAttributesW(files.oldEffect.c_str());
    CHECK(replacementAttributes != INVALID_FILE_ATTRIBUTES && (replacementAttributes & FILE_ATTRIBUTE_READONLY));
    checkEffect(files.oldEffect, replacement, replacementAttributes);

    {
        EffectDeleteObservation observedDelete(files.oldEffect);
        EffectDeleteHook hook(observedDelete);
        for (unsigned attempt = 1; attempt <= 2; ++attempt) {
            std::string rejection;
            observedDelete.Begin();
            try { RecoverProjectPair(target); }
            catch (const std::runtime_error& ex) { rejection = ex.what(); }
            observedDelete.End();
            CHECK(rejection == "rolled-back EMM stage does not match its saved generation");
            CHECK(observedDelete.matches == 0);
            checkEffect(files.oldEffect, replacement, replacementAttributes);
            CHECK(ReadFile(files.journal) == record);
            for (const auto* path : {&files.newMain, &files.newSide, &files.oldMain, &files.oldSide,
                                     &files.tempJournal}) CHECK(!fs::exists(*path));
            checkPublic();
        }
    }

    CHECK(MoveFileExW(files.oldEffect.c_str(), external.c_str(), MOVEFILE_WRITE_THROUGH));
    CHECK(MoveFileExW(original.c_str(), files.oldEffect.c_str(), MOVEFILE_WRITE_THROUGH));
    checkEffect(files.oldEffect, *oracle.middle[1], originalAttributes);
    checkEffect(external, replacement, replacementAttributes);
    CHECK(ReadFile(files.journal) == record);
    Write(dir / L"cleanup-prefix.txt", "old-effect-restored");
    for (const auto* mode : {L"--version-storage-recovery-first", L"--version-storage-recovery-second"}) {
        Child retry(mode, id, dir);
        CHECK(retry.Join() == 0);
        CheckClean(files);
        checkPublic();
        checkEffect(external, replacement, replacementAttributes);
    }
    std::cout << "PASS SAVE-01 external old-effect replacement, two denied attempts and two fresh retries"
              << std::endl;
}

struct StageCleanupSwap {
    fs::path stage, parked, replacement;
    BY_HANDLE_FILE_INFORMATION original{};
    unsigned attempts = 0;
    DWORD renameError = ERROR_SUCCESS;
    DWORD attributesDuringDelete = INVALID_FILE_ATTRIBUTES;
    bool moved = false, copied = false;
    bool refuseDisposition = false;

    void Attempt() noexcept {
        ++attempts;
        moved = MoveFileExW(stage.c_str(), parked.c_str(), MOVEFILE_WRITE_THROUGH) != FALSE;
        renameError = moved ? ERROR_SUCCESS : GetLastError();
        if (moved) copied = CopyFileW(replacement.c_str(), stage.c_str(), TRUE) != FALSE;
    }
};

static thread_local StageCleanupSwap* cleanupSwap = nullptr;
static decltype(&DeleteFileW) pathDelete;
static decltype(&SetFileInformationByHandle) handleSetInfo;

static BOOL WINAPI BeforeStagePathDelete(LPCWSTR path) {
    const DWORD incoming = GetLastError();
    if (cleanupSwap && path && !wcscmp(cleanupSwap->stage.c_str(), path)) {
        cleanupSwap->attributesDuringDelete = GetFileAttributesW(path);
        cleanupSwap->Attempt();
    }
    SetLastError(incoming);
    return pathDelete(path);
}

static BOOL WINAPI BeforeStageDisposition(HANDLE file, FILE_INFO_BY_HANDLE_CLASS type, LPVOID data, DWORD size) {
    const DWORD incoming = GetLastError();
    if (cleanupSwap && type == FileDispositionInfo && data && size == sizeof(FILE_DISPOSITION_INFO) &&
        static_cast<const FILE_DISPOSITION_INFO*>(data)->DeleteFile) {
        BY_HANDLE_FILE_INFORMATION actual{};
        const auto& expected = cleanupSwap->original;
        if (GetFileInformationByHandle(file, &actual) && actual.dwVolumeSerialNumber == expected.dwVolumeSerialNumber &&
            actual.nFileIndexHigh == expected.nFileIndexHigh && actual.nFileIndexLow == expected.nFileIndexLow) {
            cleanupSwap->attributesDuringDelete = actual.dwFileAttributes;
            cleanupSwap->Attempt();
            if (cleanupSwap->refuseDisposition) {
                SetLastError(ERROR_ACCESS_DENIED);
                return FALSE;
            }
        }
    }
    SetLastError(incoming);
    return handleSetInfo(file, type, data, size);
}

enum class CleanupMember { Main, Effect, Journal };

int RunStageCleanupIdentityCase(CleanupMember member = CleanupMember::Main) {
    const bool effect = member == CleanupMember::Effect;
    const bool journal = member == CleanupMember::Journal;
    const auto id = Wide(StorageId());
    const auto dir = Directory(id), target = dir / L"active.pmm", stage = dir / L"stage.pmm";
    CHECK(fs::create_directory(dir));
    Write(dir / L"recovery-case.txt", "rollback-6");
    const auto seed = SeedRetainedPair(target, stage);
    SaveOracle(dir / L"oracle" / L"oldest.pmm", seed.oldest);
    SaveOracle(dir / L"oracle" / L"middle.pmm", seed.middle);
    Handle barrier(CreateEventW(nullptr, TRUE, FALSE, ReadyName(id).c_str()));
    Child writer(L"--version-storage-recovery-write", id, dir);
    writer.AwaitBarrier(barrier.value);
    const RecoveryOracle oracle(dir);
    const auto record = ReadFile(fs::path(target.native() + L".mms-save.json"));
    const auto files = CheckJournal(dir, record, false);
    writer.Interrupt();
    CHECK(writer.Join() == interrupted);
    CHECK(ReadFile(files.newMain) == *oracle.fresh[0]);

    if (effect) {
        Write(dir / L"writer-journal.json", record);
        CHECK(ResetEvent(barrier.value));
        Child recovery(L"--version-storage-recovery-interrupt", id, dir);
        recovery.AwaitBarrier(barrier.value);
        recovery.Interrupt();
        CHECK(recovery.Join() == interrupted);
        CHECK(ReadFile(files.oldEffect) == *oracle.middle[1]);
        const DWORD attributes = GetFileAttributesW(files.oldEffect.c_str());
        CHECK(attributes != INVALID_FILE_ATTRIBUTES);
        CHECK(SetFileAttributesW(files.oldEffect.c_str(), attributes | FILE_ATTRIBUTE_READONLY));
    }
    StageCleanupSwap swap{effect ? files.oldEffect : journal ? files.journal : files.newMain,
        dir / L"verified-stage", dir / L"external"};
    swap.refuseDisposition = effect;
    constexpr char external[] = "independent replacement bytes";
    Write(swap.replacement, external);
    {
        Handle file(CreateFileW(swap.stage.c_str(), FILE_READ_ATTRIBUTES,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, 0, nullptr));
        CHECK(GetFileInformationByHandle(file.value, &swap.original));
    }
    std::string failure;
    {
        CHECK(MH_Initialize() == MH_OK);
        struct Hooks {
            ~Hooks() { cleanupSwap = nullptr; MH_Uninitialize(); }
        } hooks;
        auto* deleteApi = reinterpret_cast<void*>(&DeleteFileW);
        auto* setInfoApi = reinterpret_cast<void*>(&SetFileInformationByHandle);
        CHECK(MH_CreateHook(deleteApi, reinterpret_cast<void*>(&BeforeStagePathDelete),
            reinterpret_cast<void**>(&pathDelete)) == MH_OK);
        CHECK(MH_CreateHook(setInfoApi, reinterpret_cast<void*>(&BeforeStageDisposition),
            reinterpret_cast<void**>(&handleSetInfo)) == MH_OK);
        CHECK(MH_EnableHook(deleteApi) == MH_OK && MH_EnableHook(setInfoApi) == MH_OK);
        cleanupSwap = &swap;
        try { RecoverProjectPair(target); }
        catch (const std::runtime_error& error) { failure = error.what(); }
    }
    std::cout << "SAVE-01 cleanup identity member=" << (effect ? "old-emm" : journal ? "journal" : "new-pmm")
              << " fixture=" << Utf8(dir.native()) << " attempts=" << swap.attempts
              << " renamed=" << swap.moved << " copied=" << swap.copied << " rename_error=" << swap.renameError
              << " stage_exists=" << fs::exists(swap.stage) << " parked_exists=" << fs::exists(swap.parked)
              << " attributes_at_delete=" << swap.attributesDuringDelete << " failure=" << failure << std::endl;
    CHECK(swap.attempts == 1 && !swap.moved && !swap.copied && swap.renameError == ERROR_SHARING_VIOLATION);
    CHECK(!fs::exists(swap.parked) && ReadFile(swap.replacement) == external);
    CHECK(ObserveChain(target) == oracle.Before());
    if (effect) {
        CHECK(failure == "remove recovery stage (Win32 5)");
        CHECK(swap.attributesDuringDelete != INVALID_FILE_ATTRIBUTES &&
              !(swap.attributesDuringDelete & FILE_ATTRIBUTE_READONLY));
        CHECK(GetFileAttributesW(swap.stage.c_str()) == swap.original.dwFileAttributes);
        CHECK(ReadFile(swap.stage) == *oracle.middle[1] && ReadFile(files.journal) == record);
        CheckEffectCleanupDeniedStages(files, oracle);
        RecoverProjectPair(target);
    } else {
        CHECK(failure.empty());
    }
    CheckClean(files);
    RecoverProjectPair(target);
    CHECK(ObserveChain(target) == oracle.Before());
    CheckClean(files);
    std::cout << "PASS SAVE-01 cleanup preserves the verified staged file identity"
              << (effect ? " and restores read-only EMM attributes on refusal" : "") << std::endl;
    return 0;
}

struct PrepublicationSwap {
    fs::path liveJournal, parked, staged, temporaryJournal;
    bool effect = false;
    bool moved = false, copied = false;
    DWORD injectionError = ERROR_SUCCESS;
};
static PrepublicationSwap* prepublicationSwap = nullptr;

static BOOL WINAPI DenyJournalAfterReplacingStage(LPCWSTR from, LPCWSTR to, DWORD flags) {
    auto* swap = prepublicationSwap;
    if (!swap || !from || !to || swap->liveJournal != fs::path(to))
        return originalMove(from, to, flags);

    swap->temporaryJournal = from;
    const auto base = swap->temporaryJournal.parent_path() / swap->temporaryJournal.stem();
    if (swap->effect) {
        const auto name = base.filename().native();
        const auto id = name.substr(name.size() - 32);
        swap->staged = base.parent_path() / (L".mms-" + id + L".old-emm");
    } else {
        swap->staged = base.native() + L".new-pmm";
    }
    swap->moved = originalMove(swap->staged.c_str(), swap->parked.c_str(), MOVEFILE_WRITE_THROUGH) != FALSE;
    if (swap->moved) swap->copied = CopyFileW(swap->parked.c_str(), swap->staged.c_str(), TRUE) != FALSE;
    if (!swap->copied) swap->injectionError = GetLastError();
    SetLastError(ERROR_ACCESS_DENIED);
    return FALSE;
}

