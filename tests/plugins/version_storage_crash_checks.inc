            PublishProjectPair(target, stage, data, false, [&](unsigned step) {
                if (step != 3) return;
                record = ReadFile(journal);
                CHECK(MoveFileExW(journal.c_str(), authentic.c_str(), MOVEFILE_WRITE_THROUGH));
                CHECK(CopyFileW(authentic.c_str(), journal.c_str(), TRUE));
            }, retained);
        } catch (const std::runtime_error& error) { failure = error.what(); }
        CHECK(failure == "recovery record changed before cleanup");
        CHECK(!record.empty() && ReadFile(journal) == record && ReadFile(authentic) == record);
        CHECK(ReadFile(target) == fresh && DecodeProject(ReadFile(PluginSidecar(target))).mainHash == FileHash(target));
        CHECK(MoveFileExW(journal.c_str(), replacement.c_str(), MOVEFILE_WRITE_THROUGH));
        CHECK(MoveFileExW(authentic.c_str(), journal.c_str(), MOVEFILE_WRITE_THROUGH));
