// File-level hard interruption of keepPrevious and of recovery itself. Hooks
// exist only in owned children and always perform the real rename first.
#include <MinHook.h>
#include "../../src/io/pmm_save_versions.hpp"
#include "../save_journal_fixture.hpp"
#include <array>
