            RecoverProjectPair(target);
            CHECK(!fs::exists(journal) && ReadFile(replacement) == record);
            CHECK(ReadFile(target) == fresh && ReadPluginProject(target).mainHash == FileHash(target));
            if (retained) CHECK(ReadFile(target.native() + L"1") == previous);
            CHECK(!fs::exists(target.native() + L"11"));
        }
    }
    std::cout << "PASS SAVE-01 byte-identical replacement recovery records survive publication cleanup" << std::endl;
