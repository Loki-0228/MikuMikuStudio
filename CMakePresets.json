{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "win7-x64",
      "displayName": "Win7 SP1 x64 CPU baseline",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/cmake",
      "toolchainFile": "${sourceDir}/build/conan/build/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.19041.0",
        "CMAKE_TRY_COMPILE_CONFIGURATION": "Release",
        "MIKUMIKUSTUDIO_WIN7_BASELINE": "ON",
        "MIKUMIKUSTUDIO_ENABLE_DX12": "OFF",
        "MIKUMIKUSTUDIO_PROFILE": "full"
      }
    },
    {
      "name": "modern-x64",
      "displayName": "Windows 10/11 x64 with DX12 compute",
      "inherits": "win7-x64",
      "binaryDir": "${sourceDir}/build/modern",
      "toolchainFile": "${sourceDir}/build/conan-modern/build/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "MIKUMIKUSTUDIO_WIN7_BASELINE": "OFF",
        "MIKUMIKUSTUDIO_ENABLE_DX12": "ON",
        "MIKUMIKUSTUDIO_PROFILE": "full"
      }
    }
  ],
  "buildPresets": [
    { "name": "win7-x64-release", "configurePreset": "win7-x64", "configuration": "Release", "jobs": 1 },
    { "name": "modern-x64-release", "configurePreset": "modern-x64", "configuration": "Release", "jobs": 1 }
  ],
  "testPresets": [
    { "name": "win7-x64-release", "configurePreset": "win7-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "modern-x64-release", "configurePreset": "modern-x64", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
